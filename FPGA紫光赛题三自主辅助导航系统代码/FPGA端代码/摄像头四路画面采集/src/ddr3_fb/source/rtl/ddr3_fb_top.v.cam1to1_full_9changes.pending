//-----------------------------------------------------------------------------
// module i2c_com   (from official 10_HDMI_DDR3_OV5640_test, used by reg_config)
//-----------------------------------------------------------------------------
//////////////////////////////////////////////////////////////////////////////////
// Company:Meyesemi 
// Engineer: Will
// 
// Create Date: 2023-03-17  
// Design Name:  
// Module Name: 
// Project Name: 
// Target Devices: Pango
// Tool Versions: 
// Description: 
//      
// Dependencies: 
// 
// Revision:
// Revision 1.0 - File Created
// Additional Comments:
// 
//////////////////////////////////////////////////////////////////////////////////
//sclk，sdin数据传输时序代码（i2c写控制代码）
module i2c_com(clock_i2c        ,  //i2c控制接口传输所需时钟，0-400khz，此处为20khz
               camera_rstn      ,     
               ack              ,  //应答信号
               i2c_data         ,  //sdin接口传输的32位数据
               start            ,  //开始传输标志
               tr_end           ,  //传输结束标志
               i2c_sclk         ,  //FPGA与camera iic时钟接口
               i2c_sdat            //FPGA与camera iic数据接口
);        
    input [31:0]i2c_data;
    input camera_rstn;
    input clock_i2c;
    output ack;
    input start;
    output tr_end;
    output i2c_sclk;
    inout i2c_sdat;
    reg [5:0] cyc_count;
    reg reg_sdat;
    reg sclk;
    reg ack1,ack2,ack3;
    reg tr_end;
 
   
    wire i2c_sclk;
    wire i2c_sdat;
    wire ack;
   
    assign ack=ack1|ack2|ack3;
    assign i2c_sclk=sclk|(((cyc_count>=4)&(cyc_count<=39))?~clock_i2c:0);
    assign i2c_sdat=reg_sdat?1'bz:0; 
   
    always@(posedge clock_i2c)
    begin
       if(!camera_rstn)
         cyc_count<=6'b111111;
       else 
		   begin
           if(start==0)
             cyc_count<=0;
           else if(cyc_count<6'b111111)
             cyc_count<=cyc_count+1;
         end
    end
	 
	 
    always@(posedge clock_i2c)
    begin
       if(!camera_rstn)
       begin
          tr_end<=0;
          ack1<=1;
          ack2<=1;
          ack3<=1;
          sclk<=1;
          reg_sdat<=1;
       end
       else
          case(cyc_count)
          0:begin ack1<=1;ack2<=1;ack3<=1;tr_end<=0;sclk<=1;reg_sdat<=1;end
          1:reg_sdat<=0;                 //开始传输
          2:sclk<=0;
          3:reg_sdat<=i2c_data[31];
          4:reg_sdat<=i2c_data[30];
          5:reg_sdat<=i2c_data[29];
          6:reg_sdat<=i2c_data[28];
          7:reg_sdat<=i2c_data[27];
          8:reg_sdat<=i2c_data[26];
          9:reg_sdat<=i2c_data[25];
          10:reg_sdat<=i2c_data[24];
          11:reg_sdat<=1;                //应答信号
          12:begin reg_sdat<=i2c_data[23];ack1<=i2c_sdat;end
          13:reg_sdat<=i2c_data[22];
          14:reg_sdat<=i2c_data[21];
          15:reg_sdat<=i2c_data[20];
          16:reg_sdat<=i2c_data[19];
          17:reg_sdat<=i2c_data[18];
          18:reg_sdat<=i2c_data[17];
          19:reg_sdat<=i2c_data[16];
          20:reg_sdat<=1;                //应答信号       
          21:begin reg_sdat<=i2c_data[15];ack1<=i2c_sdat;end
          22:reg_sdat<=i2c_data[14];
          23:reg_sdat<=i2c_data[13];
          24:reg_sdat<=i2c_data[12];
          25:reg_sdat<=i2c_data[11];
          26:reg_sdat<=i2c_data[10];
          27:reg_sdat<=i2c_data[9];
          28:reg_sdat<=i2c_data[8];
          29:reg_sdat<=1;                //应答信号       
          30:begin reg_sdat<=i2c_data[7];ack2<=i2c_sdat;end
          31:reg_sdat<=i2c_data[6];
          32:reg_sdat<=i2c_data[5];
          33:reg_sdat<=i2c_data[4];
          34:reg_sdat<=i2c_data[3];
          35:reg_sdat<=i2c_data[2];
          36:reg_sdat<=i2c_data[1];
          37:reg_sdat<=i2c_data[0];
          38:reg_sdat<=1;                //应答信号       
          39:begin ack3<=i2c_sdat;sclk<=0;reg_sdat<=0;end
          40:sclk<=1;
          41:begin reg_sdat<=1;tr_end<=1;end
          endcase
       
end

endmodule


//=============================================================================
// module mosaic_wr  --  双摄像头左右同屏合成器（2026-10-28 新增）
//
//   ★ 目标：把两颗 1280x720 摄像头合成【一帧】1280x720：
//       左 640 像素 = cam1（水平 2:1 抽稀）
//       右 640 像素 = cam2（水平 2:1 抽稀）
//     然后送给【单个】fram_buf -> 完全不需要 AXI 仲裁器。
//
//   ★ 为什么可以不按摄像头真实时序：
//     fram_buf 内部的 wr_buf 只看三件事：
//       1) wr_fsync 出现一次上升沿（置 wr_enable）
//       2) 每行 wr_en 连续高 >= H_NUM-20 拍（本例 1280 拍）
//       3) 行间 wr_en 低 >= 1 拍（复位 x_cnt、产生 y_cnt 上升沿）
//     所以写器可以用独立的 sys_clk(50MHz) 自由跑，不必跟着摄像头时钟。
//     好处：彻底消除"时钟二选一 mux"带来的稳定性隐患。
//
//   ★ 防死锁：以 cam1 的行节拍为主。cam2 用"最新可用 bank"，
//     如果 cam2 还没更新就重复上一行。任何一颗停了都不会卡住整条链。
//
//   ★ 每段行内：o_de 连续高 1280 拍，数据按 左640 + 右640 顺序输出。
//     行间 o_de 拉低 1 拍。每 V_NUM 行发一次 o_fsync。

//=============================================================================
// module quad_wr  --  四路视频合成写器（2026-10-28 新增）
//
//   ★ 目标：把一帧 1920x1080 的合成画面写进 fram_buf，其中
//       上半屏 1920x540  = HDMI 输入原样（电脑播放"左上视频1 + 右上视频2"）
//       下半屏 1920x540  = 左 960 = cam1 缩放，右 960 = cam2 缩放
//
//   ★ 为什么写侧这么简单：
//       HDMI 的 de 天然就是"每行恰好 1920 拍高 + 消隐低"，正好满足 wr_buf 的
//       三个硬要求（每行连续 >= H_NUM-20 拍 / 行间低 >=1 拍 / 每帧一次 fsync 上升沿）。
//       所以 o_de 直接等于 hd_de，不需要任何额外时序生成。
//
//   ★ 摄像头缩放（Bresenham 累积器，不用除法器）：
//       水平：源行宽 src_w（由写侧实测并锁存）→ 960 个输出像素
//             输出第 i 个像素对应的源索引 = floor(i * src_w / 960)
//       垂直：固定 3/4（720 行 → 540 行，每 4 行丢 1 行）
//       这样无论摄像头实际是 1280x720 还是 640x480，横向都能铺满 960，不会留陈旧列。
//
//   ★ 跨时钟域：
//       摄像头行缓存写在 cam 时钟域，本模块在 HDMI 时钟域读。
//       用"行就绪翻转标志 + 2 级同步 + 边沿检测"跨域，与已验证的双摄同屏完全相同。
//
//   ★ 安全性：cam 时钟停了也不会卡死 —— 一直重复上一行。
//=============================================================================
module quad_wr #(
    parameter integer H_LINE   = 1920,   // 合成行宽
    parameter integer V_HALF   = 540,    // 上下半分界
    parameter integer H_CELL   = 960,    // 每格宽 = 行缓存深度
    parameter integer LB_AW    = 10      // 行缓存地址位宽（H_CELL <= 1024）
)(
    input  wire        hd_clk,      // HDMI 像素时钟 pixclk_in
    input  wire        rst_n,
    input  wire        hd_de,       // HDMI 数据有效
    input  wire [15:0] hd_pix,      // HDMI RGB565
    input  wire        hd_vs,       // HDMI 自造场同步
    // 摄像头 1
    input  wire        c1_clk,
    input  wire        c1_de,
    input  wire        c1_vs,
    input  wire [15:0] c1_pix,
    // 摄像头 2
    input  wire        c2_clk,
    input  wire        c2_de,
    input  wire        c2_vs,
    input  wire [15:0] c2_pix,
    // 输出（hd_clk 域）
    output reg         o_de,
    output reg  [15:0] o_pix,
    output reg         o_fsync,
    // 诊断
    output wire [15:0] dbg_srcw1,
    output wire [15:0] dbg_srcw2,
    output wire [15:0] dbg_srch1,
    output wire [15:0] dbg_srch2
);

    //==========================================================================
    // 一、HDMI 侧坐标计数（只用 de，不依赖 vs/hs）
    //==========================================================================
    reg [11:0] hd_x, hd_y;
    reg        hd_de_d;

    always @(posedge hd_clk or negedge rst_n) begin
        if (!rst_n) begin
            hd_x <= 12'd0; hd_y <= 12'd0; hd_de_d <= 1'b0;
        end else begin
            hd_de_d <= hd_de;
            if (hd_de) begin
                if (hd_x == H_LINE-1) begin
                    hd_x <= 12'd0;
                    hd_y <= (hd_y == 12'd1079) ? 12'd0 : hd_y + 12'd1;
                end else hd_x <= hd_x + 12'd1;
            end
            if (hd_vs) hd_y <= 12'd0;
        end
    end

    //==========================================================================
    // 二、行缓存：每颗 2 bank x H_CELL x 16bit
    //     写侧做 3/4 水平抽稀（1280 -> 960），读侧直接按 hd_x 索引
    //     结构完全照搬已验证的 mosaic_wr，只把 1/2 改成 3/4
    //==========================================================================
    reg [15:0] lb1 [0:(2<<LB_AW)-1];   // 2 bank x (1<<LB_AW)，bank 必须是 2 的幂
    reg [15:0] lb2 [0:(2<<LB_AW)-1];

    //------------------------------ cam1 --------------------------------------
    reg [1:0]  c1_cnt;          // 0,1,2 写 ; 3 跳过  -> 1280*3/4 = 960
    reg [3:0]  c1_vcnt;         // 垂直：0,1,2 保留 ; 3 跳过 -> 720*3/4 = 540
    reg [LB_AW-1:0] c1_waddr;
    reg        c1_de_d, c1_vs_d;
    reg        c1_bank, c1_rdy_tgl;
    reg [11:0] c1_srcw, c1_flines, c1_srch;
    reg [11:0] c1_pixcnt;        // 本行源像素数（诊断用）
    // ★ 行结束滤波：de 必须持续低 64 拍才算一行结束，一行只产生一次脉冲
    //   （原来直接用 de 下降沿，若 de 抖动会多次触发 -> bank 反复切换 -> 画面出现多份重复）
    reg [6:0] c1_low_cnt;
    always @(posedge c1_clk or negedge rst_n) begin
        if (!rst_n)                    c1_low_cnt <= 7'd0;
        else if (c1_de)                c1_low_cnt <= 7'd0;
        else if (c1_low_cnt != 7'd127) c1_low_cnt <= c1_low_cnt + 7'd1;
    end
    wire c1_line_end = (c1_low_cnt == 7'd63);
    wire       c1_vs_rise  = c1_vs & ~c1_vs_d;
    wire       c1_vkeep    = (c1_vcnt != 4'd3);      // 垂直 3/4

    always @(posedge c1_clk or negedge rst_n) begin
        if (!rst_n) begin
            c1_de_d <= 1'b0; c1_vs_d <= 1'b0;
            c1_cnt  <= 2'd0; c1_vcnt <= 4'd0;
            c1_waddr<= {LB_AW{1'b0}};
            c1_srcw <= 12'd0; c1_flines <= 12'd0; c1_srch <= 12'd0;
        end else begin
            c1_de_d <= c1_de;
            c1_vs_d <= c1_vs;
            if (!c1_de) begin
                c1_cnt   <= 2'd0;
                c1_waddr <= {LB_AW{1'b0}};
                c1_pixcnt<= 12'd0;
            end else begin
                c1_cnt <= c1_cnt + 2'd1;
                c1_pixcnt<= c1_pixcnt + 12'd1;
                if ((c1_cnt != 2'd3) && c1_vkeep && (c1_waddr < H_CELL-1))
                    c1_waddr <= c1_waddr + 1'b1;
            end
            if (c1_line_end) begin
                c1_vcnt   <= (c1_vcnt == 4'd3) ? 4'd0 : c1_vcnt + 4'd1;
                c1_srcw   <= c1_pixcnt;
                c1_flines <= c1_flines + 12'd1;
            end
            if (c1_vs_rise) begin
                c1_srch   <= c1_flines;
                c1_flines <= 12'd0;
            end
        end
    end

    // 写使能：不在第 4 个像素、垂直保留行、地址未越界
    wire c1_wr_en = c1_de & (c1_cnt != 2'd3) & c1_vkeep & (c1_waddr < H_CELL);   // 允许写 0..959

    always @(posedge c1_clk) begin
        if (c1_wr_en) lb1[{c1_bank, c1_waddr}] <= c1_pix;
    end

    always @(posedge c1_clk or negedge rst_n) begin
        if (!rst_n) begin c1_bank <= 1'b0; c1_rdy_tgl <= 1'b0; end
        else if (c1_line_end && c1_vkeep) begin
            c1_bank    <= ~c1_bank;
            c1_rdy_tgl <= ~c1_rdy_tgl;
        end
    end

    //------------------------------ cam2 --------------------------------------
    reg [1:0]  c2_cnt;
    reg [3:0]  c2_vcnt;
    reg [LB_AW-1:0] c2_waddr;
    reg        c2_de_d, c2_vs_d;
    reg        c2_bank, c2_rdy_tgl;
    reg [11:0] c2_srcw, c2_flines, c2_srch;
    reg [11:0] c2_pixcnt;
    reg [6:0] c2_low_cnt;
    always @(posedge c2_clk or negedge rst_n) begin
        if (!rst_n)                    c2_low_cnt <= 7'd0;
        else if (c2_de)                c2_low_cnt <= 7'd0;
        else if (c2_low_cnt != 7'd127) c2_low_cnt <= c2_low_cnt + 7'd1;
    end
    wire c2_line_end = (c2_low_cnt == 7'd63);
    wire       c2_vs_rise  = c2_vs & ~c2_vs_d;
    wire       c2_vkeep    = (c2_vcnt != 4'd3);

    always @(posedge c2_clk or negedge rst_n) begin
        if (!rst_n) begin
            c2_de_d <= 1'b0; c2_vs_d <= 1'b0;
            c2_cnt  <= 2'd0; c2_vcnt <= 4'd0;
            c2_waddr<= {LB_AW{1'b0}};
            c2_srcw <= 12'd0; c2_flines <= 12'd0; c2_srch <= 12'd0;
        end else begin
            c2_de_d <= c2_de;
            c2_vs_d <= c2_vs;
            if (!c2_de) begin
                c2_cnt   <= 2'd0;
                c2_waddr <= {LB_AW{1'b0}};
                c2_pixcnt<= 12'd0;
            end else begin
                c2_cnt <= c2_cnt + 2'd1;
                c2_pixcnt<= c2_pixcnt + 12'd1;
                if ((c2_cnt != 2'd3) && c2_vkeep && (c2_waddr < H_CELL-1))
                    c2_waddr <= c2_waddr + 1'b1;
            end
            if (c2_line_end) begin
                c2_vcnt   <= (c2_vcnt == 4'd3) ? 4'd0 : c2_vcnt + 4'd1;
                c2_srcw   <= c2_pixcnt;
                c2_flines <= c2_flines + 12'd1;
            end
            if (c2_vs_rise) begin
                c2_srch   <= c2_flines;
                c2_flines <= 12'd0;
            end
        end
    end

    wire c2_wr_en = c2_de & (c2_cnt != 2'd3) & c2_vkeep & (c2_waddr < H_CELL);   // 允许写 0..959

    always @(posedge c2_clk) begin
        if (c2_wr_en) lb2[{c2_bank, c2_waddr}] <= c2_pix;
    end

    always @(posedge c2_clk or negedge rst_n) begin
        if (!rst_n) begin c2_bank <= 1'b0; c2_rdy_tgl <= 1'b0; end
        else if (c2_line_end && c2_vkeep) begin
            c2_bank    <= ~c2_bank;
            c2_rdy_tgl <= ~c2_rdy_tgl;
        end
    end

    //==========================================================================
    // 三、跨到 hd_clk 域：bank 必须锁存【翻转前】的值
    //     （这是已验证版的写法：rb*_hold 与 rb* 同拍更新，
    //       rb*_hold 拿到的是旧值 -> 正是刚写完的那个 bank）
    //==========================================================================
    reg [2:0] c1_rdy_s, c2_rdy_s;
    always @(posedge hd_clk or negedge rst_n) begin
        if (!rst_n) begin c1_rdy_s <= 3'd0; c2_rdy_s <= 3'd0; end
        else begin
            c1_rdy_s <= {c1_rdy_s[1:0], c1_rdy_tgl};
            c2_rdy_s <= {c2_rdy_s[1:0], c2_rdy_tgl};
        end
    end
    wire c1_new = (c1_rdy_s[2:1] == 2'b01);
    wire c2_new = (c2_rdy_s[2:1] == 2'b01);

    reg rb1, rb2, rb1_hold, rb2_hold;
    always @(posedge hd_clk or negedge rst_n) begin
        if (!rst_n) begin
            rb1 <= 1'b0; rb2 <= 1'b0;
            rb1_hold <= 1'b0; rb2_hold <= 1'b0;
        end else begin
            if (c1_new) begin rb1_hold <= rb1; rb1 <= ~rb1; end
            if (c2_new) begin rb2_hold <= rb2; rb2 <= ~rb2; end
        end
    end

    //==========================================================================
    // 四、像素读取：直接按坐标索引，无累积器
    //     hd_x 0..959   -> lb1[hd_x]
    //     hd_x 960..1919 -> lb2[hd_x-960]
    //     行缓存读是寄存器输出，所以坐标要延迟 1 拍对齐
    //==========================================================================
    wire [11:0] cx = (hd_x >= H_CELL) ? (hd_x - H_CELL) : hd_x;
    wire [LB_AW-1:0] cxa = cx[LB_AW-1:0];

    // 输出对齐用的延迟寄存器（BRAM 读是寄存器输出，坐标要同步延迟 1 拍）
    reg        hd_de_d2;
    reg [11:0] hd_x_d, hd_y_d;
    reg [15:0] hd_pix_d;

    reg [15:0] px1, px2;
    always @(posedge hd_clk) begin
        px1 <= lb1[{rb1_hold, cxa}];
        px2 <= lb2[{rb2_hold, cxa}];
    end

    always @(posedge hd_clk or negedge rst_n) begin
        if (!rst_n) begin
            o_de <= 1'b0; o_pix <= 16'd0; o_fsync <= 1'b0;
            hd_de_d2 <= 1'b0; hd_x_d <= 12'd0; hd_y_d <= 12'd0; hd_pix_d <= 16'd0;
        end else begin
            hd_de_d2 <= hd_de;
            hd_x_d   <= hd_x;
            hd_y_d   <= hd_y;
            hd_pix_d <= hd_pix;
            o_de     <= hd_de_d2;      // 与 px1/px2 同延迟
            o_fsync  <= hd_vs;
            if (hd_y_d < V_HALF)
                o_pix <= hd_pix_d;                              // 上半屏：HDMI
            else
                o_pix <= (hd_x_d < H_CELL) ? px1 : px2;         // 下半屏：摄像头
        end
    end

    //==========================================================================
    // 诊断
    //==========================================================================
    assign dbg_srcw1 = {4'd0, c1_srcw};
    assign dbg_srcw2 = {4'd0, c2_srcw};
    assign dbg_srch1 = {4'd0, c1_srch};
    assign dbg_srch2 = {4'd0, c2_srch};

endmodule

//=============================================================================
// module mosaic_wr2  --  双摄合成写器 v2（2026-10-28 新增，移植 19:44 验证版）
//
//   ★ 与 quad_wr 的区别：数据进【framebuf 整帧缓存】，不是 HDMI 行缓存。
//     摄像头 30fps / 显示 60fps，行缓存只能存 1 行 -> 垂直必然漂移；
//     整帧缓存在 DDR3 里才不漂移（19:44 验证版就是这么做的）。
//
//   ★ 结构照搬验证版：cam 时钟域双 bank 行缓存 + 行就绪翻转跨域 + FSM
//     只改：水平抽稀 2:1 -> 3:4（2 位计数器，无累积器），H_HALF 640->960
//=============================================================================
module mosaic_wr2 #(
    parameter integer H_HALF = 960,
    parameter integer V_NUM  = 540
)(
    input  wire        clk,
    input  wire        rst_n,
    input  wire        c1_clk,
    input  wire        c1_vs,
    input  wire        c1_de,
    input  wire [15:0] c1_pix,
    input  wire        c2_clk,
    input  wire        c2_de,
    input  wire [15:0] c2_pix,
    output reg         o_fsync,
    output reg         o_de,
    output reg  [15:0] o_pix,
    output wire [15:0] dbg_srcw1,
    output wire [15:0] dbg_srcw2
);

    reg [15:0] lb1 [0:2047];
    reg [15:0] lb2 [0:2047];

    //---- cam1 ----
    reg [1:0]  c1_cnt;
    reg [9:0]  c1_waddr;
    reg        c1_de_d;
    reg        c1_bank, c1_rdy_tgl;
    reg [11:0] c1_pixcnt, c1_srcw;
    wire       c1_line_end = c1_de_d & ~c1_de;

    always @(posedge c1_clk or negedge rst_n) begin
        if (!rst_n) begin
            c1_de_d  <= 1'b0;
            c1_cnt   <= 2'd0;
            c1_waddr <= 10'd0;
            c1_pixcnt<= 12'd0;
            c1_srcw  <= 12'd0;
        end else begin
            c1_de_d <= c1_de;
            if (!c1_de) begin
                c1_cnt    <= 2'd0;
                c1_waddr  <= 10'd0;
                c1_pixcnt <= 12'd0;
            end else begin
                c1_cnt    <= c1_cnt + 2'd1;
                c1_pixcnt <= c1_pixcnt + 12'd1;
                if ((c1_cnt != 2'd3) && (c1_waddr < H_HALF-1))
                    c1_waddr <= c1_waddr + 10'd1;
            end
            if (c1_line_end) c1_srcw <= c1_pixcnt;
        end
    end

    wire c1_wr_en = c1_de & (c1_cnt != 2'd3) & (c1_waddr < H_HALF);

    always @(posedge c1_clk) begin
        if (c1_wr_en) lb1[{c1_bank, c1_waddr}] <= c1_pix;
    end

    always @(posedge c1_clk or negedge rst_n) begin
        if (!rst_n) begin c1_bank <= 1'b0; c1_rdy_tgl <= 1'b0; end
        else if (c1_line_end) begin
            c1_bank    <= ~c1_bank;
            c1_rdy_tgl <= ~c1_rdy_tgl;
        end
    end

    //---- cam2 ----
    reg [1:0]  c2_cnt;
    reg [9:0]  c2_waddr;
    reg        c2_de_d;
    reg        c2_bank, c2_rdy_tgl;
    reg [11:0] c2_pixcnt, c2_srcw;
    wire       c2_line_end = c2_de_d & ~c2_de;

    always @(posedge c2_clk or negedge rst_n) begin
        if (!rst_n) begin
            c2_de_d  <= 1'b0;
            c2_cnt   <= 2'd0;
            c2_waddr <= 10'd0;
            c2_pixcnt<= 12'd0;
            c2_srcw  <= 12'd0;
        end else begin
            c2_de_d <= c2_de;
            if (!c2_de) begin
                c2_cnt    <= 2'd0;
                c2_waddr  <= 10'd0;
                c2_pixcnt <= 12'd0;
            end else begin
                c2_cnt    <= c2_cnt + 2'd1;
                c2_pixcnt <= c2_pixcnt + 12'd1;
                if ((c2_cnt != 2'd3) && (c2_waddr < H_HALF-1))
                    c2_waddr <= c2_waddr + 10'd1;
            end
            if (c2_line_end) c2_srcw <= c2_pixcnt;
        end
    end

    wire c2_wr_en = c2_de & (c2_cnt != 2'd3) & (c2_waddr < H_HALF);

    always @(posedge c2_clk) begin
        if (c2_wr_en) lb2[{c2_bank, c2_waddr}] <= c2_pix;
    end

    always @(posedge c2_clk or negedge rst_n) begin
        if (!rst_n) begin c2_bank <= 1'b0; c2_rdy_tgl <= 1'b0; end
        else if (c2_line_end) begin
            c2_bank    <= ~c2_bank;
            c2_rdy_tgl <= ~c2_rdy_tgl;
        end
    end

    //---- 跨到 clk 域 ----
    reg [2:0] c1_rdy_s, c2_rdy_s;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin c1_rdy_s <= 3'd0; c2_rdy_s <= 3'd0; end
        else begin
            c1_rdy_s <= {c1_rdy_s[1:0], c1_rdy_tgl};
            c2_rdy_s <= {c2_rdy_s[1:0], c2_rdy_tgl};
        end
    end
    wire c1_line_new = (c1_rdy_s[2:1] == 2'b01);
    wire c2_line_new = (c2_rdy_s[2:1] == 2'b01);

    // ★ 加固1：读侧不用"翻转计数"，改用 bank 电平同步
    //   原写法一旦 FSM 忙、错过 1 拍触发脉冲，rbank* 与 *_bank 就永久失步。
    //   现在同步电平、读"正在写的相反那个"=刚写完的那个，永不失步。
    reg [1:0] c1_bank_s, c2_bank_s;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin c1_bank_s <= 2'd0; c2_bank_s <= 2'd0; end
        else begin
            c1_bank_s <= {c1_bank_s[0], c1_bank};
            c2_bank_s <= {c2_bank_s[0], c2_bank};
        end
    end
    wire rbank1 = ~c1_bank_s[1];
    wire rbank2 = ~c2_bank_s[1];

    //---- cam1 VSYNC 同步 ----
    reg [2:0] c1vs_s;
    always @(posedge clk) c1vs_s <= {c1vs_s[1:0], c1_vs};
    wire c1vs_rise = (c1vs_s[2:1] == 2'b01);

    //---- 写器 FSM（照搬验证版）----
    localparam S_WAIT = 2'd0,
               S_C1   = 2'd1,
               S_C2   = 2'd2,
               S_GAP  = 2'd3;

    // ★ 垂直 3/4 抽行：720 行摄像头 -> 540 行 framebuf
    //   没有这个，FSM 每个摄像头行都写一行，720 行会绕回覆盖开头 ->
    //   画面上下颠倒/被割成两半（就是之前看到的现象！）
    reg [3:0] c1_vcnt;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) c1_vcnt <= 4'd0;
        else if (c1_line_new) c1_vcnt <= (c1_vcnt == 4'd3) ? 4'd0 : c1_vcnt + 4'd1;
    end
    wire v_keep = (c1_vcnt != 4'd3);

    reg [1:0]  st;
    reg [11:0] line_cnt;
    reg [9:0]  raddr;
    reg        rb1_hold, rb2_hold;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            st       <= S_WAIT;
            raddr    <= 10'd0;
            line_cnt <= 12'd0;
            o_de     <= 1'b0;
            o_pix    <= 16'd0;
            o_fsync  <= 1'b0;
            rb1_hold <= 1'b0;
            rb2_hold <= 1'b0;
        end else begin
            o_fsync <= c1vs_rise;
            case (st)
                S_WAIT: begin
                    o_de <= 1'b0;
                    if (c1_line_new && v_keep) begin
                        rb1_hold <= rbank1;
                        rb2_hold <= rbank2;
                        raddr    <= 10'd0;
                        st       <= S_C1;
                    end
                end
                S_C1: begin
                    o_de  <= 1'b1;
                    o_pix <= lb1[{rb1_hold, raddr}];
                    if (raddr == H_HALF-1) begin
                        raddr <= 10'd0;
                        st    <= S_C2;
                    end else raddr <= raddr + 10'd1;
                end
                S_C2: begin
                    o_de  <= 1'b1;
                    o_pix <= lb2[{rb2_hold, raddr}];
                    if (raddr == H_HALF-1) begin
                        o_de <= 1'b0;
                        st   <= S_GAP;
                    end else raddr <= raddr + 10'd1;
                end
                S_GAP: begin
                    o_de     <= 1'b0;
                    line_cnt <= line_cnt + 12'd1;
                    st       <= S_WAIT;
                end
                default: st <= S_WAIT;
            endcase
        end
    end

    assign dbg_srcw1 = {4'd0, c1_srcw};
    assign dbg_srcw2 = {4'd0, c2_srcw};

endmodule

//=============================================================================
// module hdmi_lb  --  HDMI 行缓存（2026-10-28 新增）
//
//   HDMI 输入 60fps / 显示 60fps，速率一致（只差晶振 0.04%），行缓存足够。
//   双 bank + 就绪翻转跨域，与摄像头行缓存同一套已验证模式。
//=============================================================================
module hdmi_lb #(
    parameter integer H_LINE = 1920
)(
    input  wire        wr_clk,
    input  wire        wr_rst_n,
    input  wire        wr_de,
    input  wire [15:0] wr_pix,
    input  wire        rd_clk,
    input  wire        rd_rst_n,
    input  wire [11:0] rd_x,
    output reg  [15:0] rd_pix
);

    reg [15:0] mem [0:4095];        // 2 bank x 2048（bank 必须是 2 的幂）

    reg [10:0] waddr;
    reg        wbank, wrdy;
    reg        wde_d;
    wire       wline_end = wde_d & ~wr_de;

    always @(posedge wr_clk or negedge wr_rst_n) begin
        if (!wr_rst_n) begin
            wde_d  <= 1'b0;
            waddr  <= 11'd0;
            wbank  <= 1'b0;
            wrdy   <= 1'b0;
        end else begin
            wde_d <= wr_de;
            if (!wr_de)    waddr <= 11'd0;
            else if (waddr < H_LINE-1) waddr <= waddr + 11'd1;
            if (wline_end) begin
                wbank <= ~wbank;
                wrdy  <= ~wrdy;
            end
        end
    end

    always @(posedge wr_clk) begin
        if (wr_de) mem[{wbank, waddr}] <= wr_pix;
    end

    reg [2:0] rdy_s;
    always @(posedge rd_clk or negedge rd_rst_n) begin
        if (!rd_rst_n) rdy_s <= 3'd0;
        else           rdy_s <= {rdy_s[1:0], wrdy};
    end
    wire line_new = (rdy_s[2:1] == 2'b01);

    reg rbank, rbank_hold;
    always @(posedge rd_clk or negedge rd_rst_n) begin
        if (!rd_rst_n) begin rbank <= 1'b0; rbank_hold <= 1'b0; end
        else if (line_new) begin
            rbank_hold <= rbank;
            rbank      <= ~rbank;
        end
    end

    always @(posedge rd_clk) begin
        rd_pix <= mem[{rbank_hold, rd_x[10:0]}];
    end

endmodule

//=============================================================================
// module compose_wr -- 全帧合成写器（2026-10-29 v3）
//
//   ★ 为什么需要它：上半屏用"行缓存"无法保存行位置（会滚动），
//     下半屏用"行缓存"行数对不上（会花屏）。两者都必须进 DDR3 整帧缓存。
//
//   ★ 方案：写时钟固定为 pixclk_in(148.5MHz)，自己数 1080 行：
//       行 0~539   : 跟随 hd_de，直接把 HDMI 像素写进去（780 us 一行自然跟随）
//       行 540~1079: 自己产生 1920 拍/行，从摄像头行缓存取（cam1 960 + cam2 960）
//     时间预算 8.3ms + 7.0ms = 15.3ms < 16.7ms（HDMI 帧周期）✅
//
//   ★ 摄像头行缓存：水平 3/4 抽稀（1280->960），双 bank，行就绪翻转跨域。
//     读侧在 148.5MHz 下比摄像头产出快，同一行会重复几次 -> 纵向拉伸，
//     但方向正确、无绕回、无花屏（良性妥协）。
//=============================================================================
module compose_wr #(
    parameter integer H_LINE  = 1920,
    parameter integer V_TOP   = 540,
    parameter integer V_BOT   = 540,
    parameter integer H_CELL  = 960
)(
    input  wire        clk,         // pixclk_in 148.5MHz
    input  wire        rst_n,
    input  wire        hd_de,
    input  wire [15:0] hd_pix,
    input  wire        hd_vs,
    input  wire        c1_clk,
    input  wire        c1_vs,         // 摄像头 VSYNC（用于帧对齐）
    input  wire        c1_de,
    input  wire [15:0] c1_pix,
    input  wire        c2_clk,
    input  wire        c2_de,
    input  wire [15:0] c2_pix,
    output reg         o_de,
    output reg  [15:0] o_pix,
    output reg         o_fsync,
    output wire [15:0] dbg_srcw1,
    output wire [15:0] dbg_srcw2,
    output wire [15:0] dbg_botline,   // 本帧实际写满的摄像头行数
    output wire [15:0] dbg_camlines   // 本帧摄像头到达的行数
);

    //--------------------------------------------------------------------------
    // 摄像头行缓存：2 bank x 1024 x 16bit
    //--------------------------------------------------------------------------
    reg [15:0] lb1 [0:2047];
    reg [15:0] lb2 [0:2047];

    //---- cam1 采集 ----
    reg [1:0]  c1_cnt;
    reg [9:0]  c1_waddr;
    reg        c1_de_d;
    reg        c1_bank, c1_rdy_tgl;
    reg [11:0] c1_pixcnt, c1_srcw;
    // ★ 行结束滤波：de 持续低 64 拍才算一行结束，一行只产生一次（防 de 抖动导致多次切换 bank）
    reg [6:0] c1_low_cnt2;
    always @(posedge c1_clk or negedge rst_n) begin
        if (!rst_n)                     c1_low_cnt2 <= 7'd0;
        else if (c1_de)                 c1_low_cnt2 <= 7'd0;
        else if (c1_low_cnt2 != 7'd127) c1_low_cnt2 <= c1_low_cnt2 + 7'd1;
    end
    wire c1_line_end = (c1_low_cnt2 == 7'd3);   // ★ 4 拍滤波（原来 64 拍，若 pclk 慢则永不触发）

    always @(posedge c1_clk or negedge rst_n) begin
        if (!rst_n) begin
            c1_de_d  <= 1'b0;
            c1_cnt   <= 2'd0;
            c1_waddr <= 10'd0;
            c1_pixcnt<= 12'd0;
            c1_srcw  <= 12'd0;
        end else begin
            c1_de_d <= c1_de;
            if (!c1_de) begin
                c1_cnt    <= 2'd0;
                c1_waddr  <= 10'd0;
                c1_pixcnt <= 12'd0;
            end else begin
                c1_cnt    <= c1_cnt + 2'd1;
                c1_pixcnt <= c1_pixcnt + 12'd1;
                if ((c1_cnt != 2'd3) && (c1_waddr < H_CELL-1))
                    c1_waddr <= c1_waddr + 10'd1;
            end
            if (c1_line_end) c1_srcw <= c1_pixcnt;
        end
    end

    wire c1_wr_en = c1_de & (c1_cnt != 2'd3) & (c1_waddr < H_CELL);

    always @(posedge c1_clk) begin
        if (c1_wr_en) lb1[{c1_bank, c1_waddr}] <= c1_pix;
    end

    always @(posedge c1_clk or negedge rst_n) begin
        if (!rst_n) begin c1_bank <= 1'b0; c1_rdy_tgl <= 1'b0; end
        else if (c1_line_end) begin
            c1_bank    <= ~c1_bank;
            c1_rdy_tgl <= ~c1_rdy_tgl;
        end
    end

    //---- cam2 采集 ----
    reg [1:0]  c2_cnt;
    reg [9:0]  c2_waddr;
    reg        c2_de_d;
    reg        c2_bank, c2_rdy_tgl;
    reg [11:0] c2_pixcnt, c2_srcw;
    reg [6:0] c2_low_cnt2;
    always @(posedge c2_clk or negedge rst_n) begin
        if (!rst_n)                     c2_low_cnt2 <= 7'd0;
        else if (c2_de)                 c2_low_cnt2 <= 7'd0;
        else if (c2_low_cnt2 != 7'd127) c2_low_cnt2 <= c2_low_cnt2 + 7'd1;
    end
    wire c2_line_end = (c2_low_cnt2 == 7'd3);

    always @(posedge c2_clk or negedge rst_n) begin
        if (!rst_n) begin
            c2_de_d  <= 1'b0;
            c2_cnt   <= 2'd0;
            c2_waddr <= 10'd0;
            c2_pixcnt<= 12'd0;
            c2_srcw  <= 12'd0;
        end else begin
            c2_de_d <= c2_de;
            if (!c2_de) begin
                c2_cnt    <= 2'd0;
                c2_waddr  <= 10'd0;
                c2_pixcnt <= 12'd0;
            end else begin
                c2_cnt    <= c2_cnt + 2'd1;
                c2_pixcnt <= c2_pixcnt + 12'd1;
                if ((c2_cnt != 2'd3) && (c2_waddr < H_CELL-1))
                    c2_waddr <= c2_waddr + 10'd1;
            end
            if (c2_line_end) c2_srcw <= c2_pixcnt;
        end
    end

    wire c2_wr_en = c2_de & (c2_cnt != 2'd3) & (c2_waddr < H_CELL);

    always @(posedge c2_clk) begin
        if (c2_wr_en) lb2[{c2_bank, c2_waddr}] <= c2_pix;
    end

    always @(posedge c2_clk or negedge rst_n) begin
        if (!rst_n) begin c2_bank <= 1'b0; c2_rdy_tgl <= 1'b0; end
        else if (c2_line_end) begin
            c2_bank    <= ~c2_bank;
            c2_rdy_tgl <= ~c2_rdy_tgl;
        end
    end

    //--------------------------------------------------------------------------
    // 跨到写时钟域：bank 用电平同步（不会失步），行更新用翻转边沿
    //--------------------------------------------------------------------------
    reg [2:0] c1_rdy_s, c2_rdy_s;
    reg [1:0] c1_bank_s, c2_bank_s;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            c1_rdy_s  <= 3'd0; c2_rdy_s  <= 3'd0;
            c1_bank_s <= 2'd0; c2_bank_s <= 2'd0;
        end else begin
            c1_rdy_s  <= {c1_rdy_s[1:0],  c1_rdy_tgl};
            c2_rdy_s  <= {c2_rdy_s[1:0],  c2_rdy_tgl};
            c1_bank_s <= {c1_bank_s[0],   c1_bank};
            c2_bank_s <= {c2_bank_s[0],   c2_bank};
        end
    end
    wire c1_new = (c1_rdy_s[2:1] == 2'b01);
    wire c2_new = (c2_rdy_s[2:1] == 2'b01);
    wire rb1 = ~c1_bank_s[1];
    wire rb2 = ~c2_bank_s[1];

    //--------------------------------------------------------------------------
    // HDMI 侧行计数（用于切 540 行）
    //--------------------------------------------------------------------------
    reg [11:0] hd_y;
    reg        hd_de_d;
    wire       hd_line_end = hd_de_d & ~hd_de;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            hd_y <= 12'd0; hd_de_d <= 1'b0;
        end else begin
            hd_de_d <= hd_de;
            if (hd_vs)                 hd_y <= 12'd0;
            else if (hd_line_end)      hd_y <= hd_y + 12'd1;
        end
    end

    //--------------------------------------------------------------------------
    // 行缓存读（寄存器输出，PDS 才能推断成 BRAM）
    reg [15:0] px_rd;
    wire [11:0] cidx = (bot_col < H_CELL) ? bot_col : (bot_col - H_CELL);
    always @(posedge clk) begin
        px_rd <= (st == S_BOTC2) ? lb2[{rb2h, bot_col[9:0]}]
                                     : lb1[{rb1h, bot_col[9:0]}];
    end

    // 写器 FSM：S_TOP 跟随 HDMI 540 行；S_BOT 自己产 540 行摄像头
    //--------------------------------------------------------------------------
    localparam [2:0] S_WAIT = 3'd0, S_TOP = 3'd1, S_CWAIT = 3'd6,
                   S_BOTW = 3'd2, S_BOTC1 = 3'd3, S_BOTC2 = 3'd4, S_BOTG = 3'd5;

    // hd_vs 上升沿：每帧的起点
    reg hd_vs_d2;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) hd_vs_d2 <= 1'b0;
        else        hd_vs_d2 <= hd_vs;
    end
    wire hd_vs_rise = hd_vs & ~hd_vs_d2;

    // 摄像头 VSYNC 同步（用于 S_BOT 帧对齐，消除滚动）
    reg [2:0] c1vs_s;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) c1vs_s <= 3'd0;
        else        c1vs_s <= {c1vs_s[1:0], c1_vs};
    end
    wire c1vs_rise = (c1vs_s[2:1] == 2'b01);

    reg [2:0]  st;
    reg [11:0] bot_line;    // S_BOT 已写满的行数
    reg [11:0] bot_col;     // 行内列计数
    reg [1:0]  c1_vcnt2;    // 垂直 3/4 抽行计数
    reg        rb1h, rb2h;  // 本行读 bank（行开始时锁存）
    reg [1:0]  hd_vs_div;   // hd_vs 四分频：一帧 = 4 个显示帧 = 66.7ms

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) hd_vs_div <= 2'd0;
        else if (hd_vs_rise) hd_vs_div <= hd_vs_div + 2'd1;
    end
    // ★ 每 2 个 hd_vs 一次 = 33.3ms = 严格 30fps
    //   必须与显示侧 60Hz 保持 2:1 整数比，否则双缓冲切换不同步 -> 撕裂/多段/抽搐
    wire frame_start = hd_vs_rise & (hd_vs_div == 2'd3);   // 每 4 个 hd_vs = 66.7ms，写侧有余量

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            st       <= S_WAIT;
            bot_line <= 12'd0;
            bot_col  <= 12'd0;
            o_de     <= 1'b0;
            o_pix    <= 16'd0;
            o_fsync  <= 1'b0;
        end else begin
            case (st)
                //=========== 等帧起点（每 2 个 hd_vs = 33.3ms）===========
                S_WAIT: begin
                    o_de <= 1'b0;
                    if (frame_start) begin
                        o_fsync  <= 1'b1;      // ★ 帧同步只在这里发
                        bot_line <= 12'd0;
                        bot_col  <= 12'd0;
                        c1_vcnt2 <= 2'd0;
                        st       <= S_TOP;
                    end else begin
                        o_fsync  <= 1'b0;
                    end
                end
                //=========== 上半屏：完全跟随 HDMI（不变）===========
                S_TOP: begin
                    o_de    <= hd_de;
                    o_pix   <= hd_pix;
                    o_fsync <= 1'b0;
                    if (hd_line_end && (hd_y >= V_TOP-1)) begin
                        st       <= S_CWAIT;   // 等摄像头帧起点（消除滚动）
                        bot_line <= 12'd0;
                    end
                end
                //=========== 等摄像头 VSYNC（帧对齐，消除滚动）===========
                S_CWAIT: begin
                    o_de <= 1'b0;
                    if (c1vs_rise) begin
                        bot_line <= 12'd0;
                        bot_col  <= 12'd0;
                        st       <= S_BOTW;
                    end
                end
                //=========== 下半屏：等摄像头的行（3/4 抽行）===========
                S_BOTW: begin
                    o_de <= 1'b0;
                    if (c1_new) begin
                        // ★ 不做垂直抽行（对齐 1944 验证版：1:1 取摄像头前 540 行）
                        rb1h    <= rb1;     // 锁存本行要读的 bank
                        rb2h    <= rb2;
                        bot_col <= 12'd0;
                        st      <= S_BOTC1;
                    end
                end
                S_BOTC1: begin
                    o_de  <= 1'b1;
                    o_pix <= px_rd;
                    if (bot_col == H_CELL-1) begin
                        bot_col <= 12'd0;
                        st      <= S_BOTC2;
                    end else begin
                        bot_col <= bot_col + 12'd1;
                    end
                end
                //=========== 输出 960 拍 cam2 ===========
                S_BOTC2: begin
                    o_de  <= 1'b1;
                    o_pix <= px_rd;
                    if (bot_col == H_CELL-1) begin
                        o_de    <= 1'b0;
                        bot_line<= bot_line + 12'd1;
                        st      <= S_BOTG;
                    end else begin
                        bot_col <= bot_col + 12'd1;
                    end
                end
                //=========== 行间 1 拍低 + 判断写满 540 行 ===========
                S_BOTG: begin
                    o_de <= 1'b0;
                    if (bot_line >= V_BOT) begin
                        st <= S_WAIT;       // 下半屏 540 行写满
                    end else begin
                        st <= S_BOTW;
                    end
                end
                default: st <= S_WAIT;
            endcase
        end
    end

    //---- 诊断：摄像头每帧到达行数（frame_start 清零）+ 本帧写满行数 ----
    reg [11:0] camline_cnt;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n)              camline_cnt <= 12'd0;
        else if (frame_start)    camline_cnt <= 12'd0;
        else if (c1_new)         camline_cnt <= camline_cnt + 12'd1;
    end
    // ★ 诊断改为"帧末锁存"，UART 采样才有意义
    reg [11:0] lat_botline = 0, lat_camlines = 0;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin lat_botline <= 12'd0; lat_camlines <= 12'd0; end
        else if (frame_start) begin
            lat_botline  <= bot_line;
            lat_camlines <= camline_cnt;
        end
    end
    assign dbg_botline  = {4'd0, lat_botline};
    assign dbg_camlines = {4'd0, lat_camlines};

    assign dbg_srcw1 = {4'd0, c1_srcw};
    assign dbg_srcw2 = {4'd0, c2_srcw};

endmodule

//=============================================================================
// module cam_lb1  --  摄像头行缓存（版本二 2026-10-30 新增）
//
//   用途：把 cam1 的一行 RGB565 抽稀成 960 像素，供 HDMI 写侧在
//         【pixclk_in 域】按 rd_x 直接索引 —— 版本二右半屏（x=960..1919）
//         取的就是它。
//
//   写侧（c_clk = cam_pclk_16bit 域）：
//     · 水平 3/4 抽稀：每 4 个源像素丢第 4 个 -> 1280 -> 960
//     · 双 bank 乒乓：写当前 bank，读"上一个写满的 bank"
//     · 行结束用【4 拍低电平滤波】判定。
//       ⚠️ 绝不能改成 64 拍：pclk 慢时 64 拍会超过行消隐长度，
//          行结束永不触发 -> bank 不切换 -> 画面挤压成一条。
//
//   读侧（clk = pixclk_in 域）：
//     · bank 打两拍后取反 = 刚写满的那个 bank（电平同步，不会失步）
//       写侧在【行消隐期间】才翻 bank，所以读侧晚两拍看到也不会读到半行。
//     · 输出必须寄存器化（rd_pix <= mem[..]），组合读大数组 PDS 推断不出
//       BRAM，会退化成分布式 RAM。
//
//   容量：2 x 1024 x 16bit = 2 个 DRM。H_CELL 必须 <= 1024（bank 是 2 的幂）。
//
//   行为：摄像头没出图（c_de 恒低）时 bank 不翻，读侧一直读 bank1，
//         而 bank1 被 initial 清成 0 -> 右半屏是黑的，不会花屏。
//=============================================================================
`timescale 1ns / 1ps

module cam_lb1 #(
    parameter integer H_CELL = 960          // 输出宽度 = 1280 * 3/4
)(
    input  wire        clk,                 // pixclk_in，读时钟
    input  wire        rst_n,
    input  wire        c_clk,               // cam_pclk_16bit，写时钟
    input  wire        c_de,                // 摄像头行有效
    input  wire [15:0] c_pix,               // 摄像头 RGB565
    input  wire [11:0] rd_x,                // 0..959
    output reg  [15:0] rd_pix,
    output wire        o_line_new           // 新的一行写满了（clk 域 1 拍脉冲）
);

    reg [15:0] lb [0:2047];                 // 2 bank x 1024
    integer i;
    initial begin
        for (i = 0; i < 1024; i = i + 1) begin
            lb[i]        = 16'd0;
            lb[1024 + i] = 16'd0;
        end
    end
    // ⚠️ PDS 的 initial 循环上限是 2000 次，这里 1024 次，安全。
    //    若换工具报 Loop limit，直接删掉这个 initial 就行
    //    （Pango 的 DRM 上电内容本来就是全 0）。

    //-------------------------------------------------------------------------
    // 一、写侧：水平 3/4 抽稀（1280 -> 960）
    //     每 4 拍为一组：第 0/1/2 拍写，第 3 拍跳过
    //-------------------------------------------------------------------------
    reg [1:0]  cnt;
    reg [9:0]  waddr;
    reg        bank, rdy_tgl;
    reg [6:0]  low_cnt;

    // 行结束 = de 持续低 4 拍，只产生 1 个 c_clk 周期的脉冲
    wire line_end = (low_cnt == 7'd3);

    always @(posedge c_clk or negedge rst_n) begin
        if (!rst_n)                 low_cnt <= 7'd0;
        else if (c_de)              low_cnt <= 7'd0;
        else if (low_cnt != 7'd127) low_cnt <= low_cnt + 7'd1;
    end

    always @(posedge c_clk or negedge rst_n) begin
        if (!rst_n) begin
            cnt     <= 2'd0;
            waddr   <= 10'd0;
            bank    <= 1'b0;
            rdy_tgl <= 1'b0;
        end else begin
            if (!c_de) begin
                cnt   <= 2'd0;
                waddr <= 10'd0;
            end else begin
                cnt <= cnt + 2'd1;
                if ((cnt != 2'd3) && (waddr < H_CELL-1))
                    waddr <= waddr + 10'd1;
            end
            if (line_end) begin
                bank    <= ~bank;
                rdy_tgl <= ~rdy_tgl;
            end
        end
    end

    wire wr_en = c_de & (cnt != 2'd3);
    always @(posedge c_clk) begin
        if (wr_en) lb[{bank, waddr}] <= c_pix;
    end

    //-------------------------------------------------------------------------
    // 二、跨到读时钟域
    //     bank 打两拍后取反 = 上一个写满的 bank
    //     （rdy_tgl / rdy_s 与规格一致保留：目前不参与选择，留给波形观察）
    //-------------------------------------------------------------------------
    reg [2:0] rdy_s;
    reg [1:0] bank_s;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            rdy_s  <= 3'd0;
            bank_s <= 2'd0;
        end else begin
            rdy_s  <= {rdy_s[1:0], rdy_tgl};
            bank_s <= {bank_s[0],  bank};
        end
    end
    wire rb = ~bank_s[1];

    //-------------------------------------------------------------------------
    // 三、读侧（必须寄存器读）
    //-------------------------------------------------------------------------
    always @(posedge clk) begin
        rd_pix <= lb[{rb, rd_x[9:0]}];
    end

    // 新行就绪脉冲：rdy_tgl 打两拍后取上升沿（与 bank 同步一致，不会误触发）
    assign o_line_new = (rdy_s[2:1] == 2'b01);

endmodule

//=============================================================================
// module fram_buf_dual  --  双路 DDR3 帧缓存（版本二 2026-10-30 新增）
//
//   为什么需要它：
//     版本二左半是 HDMI（60fps），右半是摄像头（720P@30）。一个写口装不下两个
//     帧率不同的源：摄像头一个显示帧只给半帧，右半只能是"半帧扫描带"，摄像机
//     帧回绕的接缝就落在画面中间并随两个时钟相位的漂移慢慢滚动 —— 这就是上板
//     看到的裂屏/条纹。1944 版能干净，是因为整屏都来自摄像头、写侧跑在摄像头
//     时钟域（一个写帧 = 一个摄像头帧）。
//
//   做法：DDR3 里放两块互不相干的帧缓存
//     · 显示帧  ：1920x1080 @60fps（就是版本一那一路，接法一字未改）
//     · 摄像头帧：960x1080 @30fps（摄像机 960x720 竖直 1.5 倍拉伸）
//   两个 wr_buf / 两个 rd_buf 共用一个 wr_rd_ctrl_top（= 同一个 DDR3 AXI 口），
//   在本模块里做命令级 + 数据级仲裁：写方向同时只有一个 master，读方向同理。
//
//   摄像头读侧的"帧选择"：
//     60fps 的显示每 16.7ms 读一帧，而摄像头 33ms 才写一帧。如果让 rd_buf 按
//     rd_fsync 自己翻 bank，就会两帧一轮地读到"正在写的那块"。所以这里把
//     rd_buf 的帧选择改成外部输入 ext_frame_sel：只有一帧【写完整】之后，
//     在下一个 rd_fsync 才切换 —— 每个摄像头帧被稳定显示两遍，不闪不撕。
//
//   地址分配（DDR3 32 位字地址）：
//     0x0000_0000 起 2^23 字（32MB）给显示帧（wr_buf/rd_buf 内部用 {帧位,行}）
//     0x0080_0000 起 2^22 字（16MB）给摄像头帧（行地址 21 位，两块 bank）
//=============================================================================
module fram_buf_dual #(
    parameter MEM_ROW_WIDTH    = 15,
    parameter MEM_COLUMN_WIDTH = 10,
    parameter MEM_BANK_WIDTH   = 3,
    parameter CTRL_ADDR_WIDTH  = MEM_ROW_WIDTH + MEM_BANK_WIDTH + MEM_COLUMN_WIDTH,
    parameter MEM_DQ_WIDTH     = 32,
    parameter H_NUM            = 12'd1920,
    parameter V_NUM            = 12'd1080,
    parameter PIX_WIDTH        = 16,
    parameter CAM_H_NUM        = 12'd640,
    parameter CAM_V_NUM        = 12'd480,
    parameter [CTRL_ADDR_WIDTH-1:0] CAM_ADDR_OFFSET = 28'h080_0000
)(
    //---------------- 显示流（与 fram_buf 完全一致的接口）----------------
    input  wire                       vin_clk,
    input  wire                       wr_fsync,
    input  wire                       wr_en,
    input  wire [PIX_WIDTH-1'b1:0]    wr_data,
    output wire                       init_done,
    input  wire                       ddr_clk,
    input  wire                       ddr_rstn,
    input  wire                       vout_clk,
    input  wire                       rd_fsync,
    input  wire                       rd_en,
    output wire                       vout_de,
    output wire [PIX_WIDTH-1'b1:0]    vout_data,
    //---------------- 摄像头流 ----------------
    input  wire                       cam_vin_clk,
    input  wire                       cam_fsync,
    input  wire                       cam_en,
    input  wire [PIX_WIDTH-1'b1:0]    cam_data,
    // 摄像头读窗口（2026-10-30 晚：改成由 cam_line_rd 自己判定，见 u_rd_cam）
    input  wire                       cam_rd_de,
    input  wire [11:0]                cam_rd_x,
    output wire                       cam_vout_de,
    output wire [PIX_WIDTH-1'b1:0]    cam_vout_data,
    //---------------- AXI ----------------
    output wire [CTRL_ADDR_WIDTH-1:0] axi_awaddr,
    output wire [3:0]                 axi_awid,
    output wire [3:0]                 axi_awlen,
    output wire [2:0]                 axi_awsize,
    output wire [1:0]                 axi_awburst,
    input  wire                       axi_awready,
    output wire                       axi_awvalid,
    output wire [MEM_DQ_WIDTH*8-1:0]  axi_wdata,
    output wire [MEM_DQ_WIDTH-1:0]    axi_wstrb,
    input  wire                       axi_wlast,
    output wire                       axi_wvalid,
    input  wire                       axi_wready,
    input  wire [3:0]                 axi_bid,
    output wire [CTRL_ADDR_WIDTH-1:0] axi_araddr,
    output wire [3:0]                 axi_arid,
    output wire [3:0]                 axi_arlen,
    output wire [2:0]                 axi_arsize,
    output wire [1:0]                 axi_arburst,
    output wire                       axi_arvalid,
    input  wire                       axi_arready,
    output wire                       axi_rready,
    input  wire [MEM_DQ_WIDTH*8-1:0]  axi_rdata,
    input  wire                       axi_rvalid,
    input  wire                       axi_rlast,
    input  wire [3:0]                 axi_rid
);

    localparam LEN_WIDTH        = 32;
    localparam LINE_ADDR_WIDTH  = 22;                              // 显示帧行地址位宽
    localparam CAM_LINE_ADDR_W  = 21;                              // 摄像头帧行地址位宽
    localparam FRAME_CNT_WIDTH  = CTRL_ADDR_WIDTH - LINE_ADDR_WIDTH;

    //=========================================================================
    // 0. 摄像头"最近一个写完整的帧"所在的 bank（读侧帧选择）
    //    必须在 rd_buf 例化之前声明（规格 §4 坑 9：不能靠隐式线网）
    //=========================================================================
    reg         cam_rd_bank;

    //=========================================================================
    // 一、四块缓存实例（两写两读）
    //=========================================================================
    //---------------- 显示：写 ----------------
    wire                        dis_wreq;
    wire [CTRL_ADDR_WIDTH-1:0]  dis_waddr;
    wire [LEN_WIDTH-1:0]        dis_wlen;
    wire                        dis_wrdy, dis_wdone, dis_wdata_req, dis_wbac;
    wire [8*MEM_DQ_WIDTH-1:0]   dis_wdata;
    wire [FRAME_CNT_WIDTH-1:0]  dis_wframe;
    wire                        dis_wirq;

    wr_buf #(
        .ADDR_WIDTH       (CTRL_ADDR_WIDTH  ),
        .ADDR_OFFSET      (32'd0            ),
        .H_NUM            (H_NUM            ),
        .V_NUM            (V_NUM            ),
        .DQ_WIDTH         (MEM_DQ_WIDTH     ),
        .LEN_WIDTH        (LEN_WIDTH        ),
        .PIX_WIDTH        (PIX_WIDTH        ),
        .LINE_ADDR_WIDTH  (LINE_ADDR_WIDTH  ),
        .FRAME_CNT_WIDTH  (FRAME_CNT_WIDTH  )
    ) u_wr_dis (
        .ddr_clk       (ddr_clk        ),
        .ddr_rstn      (ddr_rstn       ),
        .wr_clk        (vin_clk        ),
        .wr_fsync      (wr_fsync       ),
        .wr_en         (wr_en          ),
        .wr_data       (wr_data        ),
        .rd_bac        (dis_wbac       ),
        .ddr_wreq      (dis_wreq       ),
        .ddr_waddr     (dis_waddr      ),
        .ddr_wr_len    (dis_wlen       ),
        .ddr_wrdy      (dis_wrdy       ),
        .ddr_wdone     (dis_wdone      ),
        .ddr_wdata     (dis_wdata      ),
        .ddr_wdata_req (dis_wdata_req  ),
        .frame_wcnt    (dis_wframe     ),
        .frame_wirq    (dis_wirq       )
    );

    //---------------- 摄像头：写 ----------------
    wire                        cam_wreq;
    wire [CTRL_ADDR_WIDTH-1:0]  cam_waddr;
    wire [LEN_WIDTH-1:0]        cam_wlen;
    wire                        cam_wrdy, cam_wdone, cam_wdata_req, cam_wbac;
    wire [8*MEM_DQ_WIDTH-1:0]   cam_wdata;
    wire [FRAME_CNT_WIDTH-1:0]  cam_wframe;

    wr_buf #(
        .ADDR_WIDTH       (CTRL_ADDR_WIDTH   ),
        .ADDR_OFFSET      (CAM_ADDR_OFFSET   ),
        .H_NUM            (CAM_H_NUM         ),
        .V_NUM            (CAM_V_NUM         ),
        .DQ_WIDTH         (MEM_DQ_WIDTH      ),
        .LEN_WIDTH        (LEN_WIDTH         ),
        .PIX_WIDTH        (PIX_WIDTH         ),
        .LINE_ADDR_WIDTH  (CAM_LINE_ADDR_W   ),
        .FRAME_CNT_WIDTH  (FRAME_CNT_WIDTH   )
    ) u_wr_cam (
        .ddr_clk       (ddr_clk        ),
        .ddr_rstn      (ddr_rstn       ),
        .wr_clk        (cam_vin_clk    ),
        .wr_fsync      (cam_fsync      ),
        .wr_en         (cam_en         ),
        .wr_data       (cam_data       ),
        .rd_bac        (cam_wbac       ),
        .ddr_wreq      (cam_wreq       ),
        .ddr_waddr     (cam_waddr      ),
        .ddr_wr_len    (cam_wlen       ),
        .ddr_wrdy      (cam_wrdy       ),
        .ddr_wdone     (cam_wdone      ),
        .ddr_wdata     (cam_wdata      ),
        .ddr_wdata_req (cam_wdata_req  ),
        .frame_wcnt    (cam_wframe     ),
        .frame_wirq    (               )
    );

    //---------------- 显示：读 ----------------
    wire                        dis_rreq;
    wire [CTRL_ADDR_WIDTH-1:0]  dis_raddr;
    wire [LEN_WIDTH-1:0]        dis_rlen;
    wire                        dis_rrdy, dis_rdone;
    wire [8*MEM_DQ_WIDTH-1:0]   dis_rdata;
    wire                        dis_rden;

    rd_buf #(
        .ADDR_WIDTH       (CTRL_ADDR_WIDTH  ),
        .ADDR_OFFSET      (32'd0            ),
        .H_NUM            (H_NUM            ),
        .V_NUM            (V_NUM            ),
        .DQ_WIDTH         (MEM_DQ_WIDTH     ),
        .LEN_WIDTH        (LEN_WIDTH        ),
        .PIX_WIDTH        (PIX_WIDTH        ),
        .LINE_ADDR_WIDTH  (LINE_ADDR_WIDTH  ),
        .FRAME_CNT_WIDTH  (FRAME_CNT_WIDTH  ),
        .EXT_FRAME_SEL    (1'b0             )
    ) u_rd_dis (
        .ddr_clk       (ddr_clk        ),
        .ddr_rstn      (ddr_rstn       ),
        .ext_frame_sel (1'b0           ),
        .vout_clk      (vout_clk       ),
        .rd_fsync      (rd_fsync       ),
        .rd_en         (rd_en          ),
        .vout_de       (vout_de        ),
        .vout_data     (vout_data      ),
        .init_done     (init_done      ),
        .ddr_rreq      (dis_rreq       ),
        .ddr_raddr     (dis_raddr      ),
        .ddr_rd_len    (dis_rlen       ),
        .ddr_rrdy      (dis_rrdy       ),
        .ddr_rdone     (dis_rdone      ),
        .ddr_rdata     (dis_rdata      ),
        .ddr_rdata_en  (dis_rden       )
    );

    //---------------- 摄像头：读（自写行指针 + 双轴 Bresenham，不是厂商 rd_buf） ----
    //   ★ 2026-10-30 晚：这里原来是 rd_buf。厂商 rd_buf 的行号只会 +1，
    //     没法让"同一源行显示两遍"，所以它做不了纵向放大（480 -> 1080）——
    //     这正是"纵向拉伸必须放在读侧"时撞上的墙。
    //     现在换成 cam_line_rd：自己维护源行指针（纵向 Bresenham）+ 源列指针
    //     （水平 Bresenham），每显示行只在源行号前进时才读一次 DDR。
    wire                        cam_rreq;
    wire [CTRL_ADDR_WIDTH-1:0]  cam_raddr;
    wire [LEN_WIDTH-1:0]        cam_rlen;
    wire                        cam_rrdy, cam_rdone;
    wire [8*MEM_DQ_WIDTH-1:0]   cam_rdata;
    wire                        cam_rden;

    cam_line_rd #(
        .SRC_W            (CAM_H_NUM      ),   // 源行宽 = 摄像头真实行宽
        .SRC_H            (CAM_V_NUM      ),   // 源行数 = 每帧真实行数
        .DST_X0           (H_NUM/2        ),   // 右半屏起点 = 960
        .DST_W            (H_NUM/2        ),   // 右半屏宽   = 960
        .DST_H            (V_NUM          )    // 屏幕高     = 1080
    ) u_rd_cam (
        .vout_clk     (vout_clk        ),
        .ddr_clk      (ddr_clk         ),
        .rst_n        (ddr_rstn        ),
        .rd_fsync     (rd_fsync        ),
        .rd_de        (cam_rd_de       ),
        .rd_x         (cam_rd_x        ),
        .frame_bank   (cam_rd_bank     ),
        .base_addr    (CAM_ADDR_OFFSET ),
        .ddr_rreq     (cam_rreq        ),
        .ddr_raddr    (cam_raddr       ),
        .ddr_rd_len   (cam_rlen        ),
        .ddr_rdone    (cam_rdone       ),
        .ddr_rdata_en (cam_rden        ),
        .ddr_rdata    (cam_rdata       ),
        .vout_data    (cam_vout_data   ),
        .vout_de      (cam_vout_de     )
    );

    //=========================================================================
    // 二、摄像头帧"写完整"检测 + 读侧帧选择
    //     cam 每写完一整帧 CAM_V_NUM 行 -> cam_done_tgl 翻转，并把那一块的 bank
    //     存下来；读侧在下一个 rd_fsync 才把 ext_frame_sel 切过去。
    //=========================================================================
    reg  [11:0] cam_line_cnt;
    reg  [2:0]  camfs_s;
    reg         cam_mybank;
    reg         cam_done_tgl;
    reg         cam_done_bank;
    wire        cam_fsync_rise = (camfs_s[2:1] == 2'b01);

    // cam_mybank 是 wr_buf 内部帧计数（从 0 开始、每帧翻转）的镜像，
    // 用摄像机 VSYNC 同步翻转；两者同源同初值，所以永远对得上。
    // 用 VSYNC 判断"上一帧写完了"比数 1080 行更稳：摄像机少给/多给一行也不会失步。
    always @(posedge ddr_clk or negedge ddr_rstn) begin
        if (!ddr_rstn) begin
            cam_line_cnt  <= 12'd0;
            camfs_s       <= 3'd0;
            cam_mybank    <= 1'b0;
            cam_done_tgl  <= 1'b0;
            cam_done_bank <= 1'b0;
        end else begin
            camfs_s <= {camfs_s[1:0], cam_fsync};
            if (cam_fsync_rise && (cam_line_cnt != 12'd0)) begin
                cam_done_bank <= cam_mybank;     // 刚写完的是这一块
                cam_mybank    <= ~cam_mybank;
                cam_done_tgl  <= ~cam_done_tgl;
                cam_line_cnt  <= 12'd0;
            end else if (cam_wdone) begin
                cam_line_cnt <= cam_line_cnt + 12'd1;
            end
        end
    end

    reg [1:0] cam_done_s;
    reg       cam_bank_s;
    reg       cam_seen;

    always @(posedge vout_clk or negedge ddr_rstn) begin
        if (!ddr_rstn) begin
            cam_done_s <= 2'd0;
            cam_bank_s <= 1'b0;
        end else begin
            cam_done_s <= {cam_done_s[0], cam_done_tgl};
            cam_bank_s <= cam_done_bank;
        end
    end

    always @(posedge vout_clk or negedge ddr_rstn) begin
        if (!ddr_rstn) begin
            cam_seen    <= 1'b0;
            cam_rd_bank <= 1'b0;
        end else if (rd_fsync && (cam_done_s[1] != cam_seen)) begin
            cam_seen    <= cam_done_s[1];
            cam_rd_bank <= cam_bank_s;
        end
    end

    //=========================================================================
    // 三、DDR3 口仲裁（命令级 + 数据级）
    //=========================================================================
    wire                       wr_cmd_en, wr_cmd_ready, wr_cmd_done, wr_data_re, wr_bac;
    wire [CTRL_ADDR_WIDTH-1:0] wr_cmd_addr;
    wire [31:0]                wr_cmd_len;
    wire [8*MEM_DQ_WIDTH-1:0]  wr_ctrl_data;

    wire                       rd_cmd_en, rd_cmd_ready, rd_cmd_done, rd_rdata_en;
    wire [CTRL_ADDR_WIDTH-1:0] rd_cmd_addr;
    wire [31:0]                rd_cmd_len;
    wire [8*MEM_DQ_WIDTH-1:0]  rd_rdata;

    //---------------- 写方向 ----------------
    reg  wr_busy, wr_sel, wr_go;
    reg  [15:0] wr_wdog;

    wire dis_own = (wr_busy && !wr_sel);
    wire cam_own = (wr_busy &&  wr_sel);
    wire wr_done_now = cam_own ? cam_wdone : dis_wdone;

    always @(posedge ddr_clk or negedge ddr_rstn) begin
        if (!ddr_rstn) begin
            wr_busy <= 1'b0;
            wr_sel  <= 1'b0;
            wr_go   <= 1'b0;
            wr_wdog <= 16'd0;
        end else begin
            wr_go <= 1'b0;
            if (!wr_busy) begin
                wr_wdog <= 16'd0;
                if (dis_wreq)      begin wr_busy <= 1'b1; wr_sel <= 1'b0; wr_go <= 1'b1; end
                else if (cam_wreq) begin wr_busy <= 1'b1; wr_sel <= 1'b1; wr_go <= 1'b1; end
            end else begin
                wr_wdog <= wr_wdog + 16'd1;
                // 正常结束 / 看门狗兜底（防止某一路卡死把整个 DDR3 口拖住）
                if (wr_done_now || (wr_wdog == 16'hFFFF))
                    wr_busy <= 1'b0;
            end
        end
    end

    assign wr_cmd_en    = wr_go;
    assign wr_cmd_addr  = wr_sel ? cam_waddr : dis_waddr;
    assign wr_cmd_len   = wr_sel ? cam_wlen  : dis_wlen;
    assign wr_ctrl_data = wr_sel ? cam_wdata : dis_wdata;

    assign dis_wrdy      = dis_own ? wr_cmd_ready : 1'b0;
    assign dis_wdone     = dis_own ? wr_cmd_done  : 1'b0;
    assign dis_wdata_req = dis_own ? wr_data_re   : 1'b0;
    assign dis_wbac      = dis_own ? wr_bac       : 1'b0;

    // ⚠️ 2026-10-30 修：这里原来漏了这一行，cam_wdone 变成隐式线网恒 0，
    //    摄像头写事务永远不结束 -> 看门狗中途放掉 -> 共享的 wr_cmd_trans 卡死
    //    -> 显示帧也写不进去（左半定格）、摄像头帧从来没写完整（右半花屏）。
    assign cam_wdone     = cam_own ? wr_cmd_done  : 1'b0;
    assign cam_wrdy      = cam_own ? wr_cmd_ready : 1'b0;
    assign cam_wdata_req = cam_own ? wr_data_re   : 1'b0;
    assign cam_wbac      = cam_own ? wr_bac       : 1'b0;

    //---------------- 读方向 ----------------
    reg  rd_busy, rd_sel, rd_go;
    reg  dis_rpend, cam_rpend;
    reg  [15:0] rd_beat;
    reg  [15:0] rd_wdog;

    wire dis_ask = dis_rreq | dis_rpend;
    wire cam_ask = cam_rreq | cam_rpend;
    wire gnt_dis = (!rd_busy) && dis_ask;
    wire gnt_cam = (!rd_busy) && (!dis_ask) && cam_ask;

    wire dis_ro = (rd_busy && !rd_sel);
    wire cam_ro = (rd_busy &&  rd_sel);
    wire rd_done_now = cam_ro ? cam_rdone : dis_rdone;
    wire [15:0] rd_len_now = rd_sel ? cam_rlen[15:0] : dis_rlen[15:0];
    wire rd_data_done = (rd_beat >= rd_len_now);

    always @(posedge ddr_clk or negedge ddr_rstn) begin
        if (!ddr_rstn) begin
            rd_busy   <= 1'b0;
            rd_sel    <= 1'b0;
            rd_go     <= 1'b0;
            dis_rpend <= 1'b0;
            cam_rpend <= 1'b0;
            rd_beat   <= 16'd0;
            rd_wdog   <= 16'd0;
        end else begin
            rd_go <= 1'b0;

            // 数据计数：只数 owner 那一路的返回数据
            if (!rd_busy)         rd_beat <= 16'd0;
            else if (rd_rdata_en) rd_beat <= rd_beat + 16'd1;

            if (!rd_busy) begin
                rd_wdog <= 16'd0;
                if (dis_ask)      begin rd_busy <= 1'b1; rd_sel <= 1'b0; rd_go <= 1'b1; end
                else if (cam_ask) begin rd_busy <= 1'b1; rd_sel <= 1'b1; rd_go <= 1'b1; end
            end else begin
                rd_wdog <= rd_wdog + 16'd1;
                if ((rd_done_now && rd_data_done) || (rd_wdog == 16'hFFFF))
                    rd_busy <= 1'b0;
            end

            // 没被立刻服务的请求挂起，等下一次（丢了会让那一路永久错行）
            dis_rpend <= dis_ask & ~gnt_dis;
            cam_rpend <= cam_ask & ~gnt_cam;
        end
    end

    assign rd_cmd_en   = rd_go;
    assign rd_cmd_addr = rd_sel ? cam_raddr : dis_raddr;
    assign rd_cmd_len  = rd_sel ? cam_rlen  : dis_rlen;

    assign dis_rrdy  = dis_ro ? rd_cmd_ready : 1'b0;
    assign dis_rdone = dis_ro ? rd_cmd_done  : 1'b0;
    assign dis_rden  = dis_ro ? rd_rdata_en  : 1'b0;
    assign cam_rrdy  = cam_ro ? rd_cmd_ready : 1'b0;
    assign cam_rdone = cam_ro ? rd_cmd_done  : 1'b0;
    assign cam_rden  = cam_ro ? rd_rdata_en  : 1'b0;

    assign dis_rdata = rd_rdata;      // 总线共享，只有 owner 的 rdata_en 有效
    assign cam_rdata = rd_rdata;

    //=========================================================================
    // 四、DDR3 控制器（读写各一路，接法与原 fram_buf 一致）
    //=========================================================================
    wr_rd_ctrl_top #(
        .CTRL_ADDR_WIDTH (CTRL_ADDR_WIDTH),
        .MEM_DQ_WIDTH    (MEM_DQ_WIDTH   )
    ) u_wr_rd_ctrl (
        .clk           (ddr_clk        ),
        .rstn          (ddr_rstn       ),
        .wr_cmd_en     (wr_cmd_en      ),
        .wr_cmd_addr   (wr_cmd_addr    ),
        .wr_cmd_len    (wr_cmd_len     ),
        .wr_cmd_ready  (wr_cmd_ready   ),
        .wr_cmd_done   (wr_cmd_done    ),
        .wr_bac        (wr_bac         ),
        .wr_ctrl_data  (wr_ctrl_data   ),
        .wr_data_re    (wr_data_re     ),
        .rd_cmd_en     (rd_cmd_en      ),
        .rd_cmd_addr   (rd_cmd_addr    ),
        .rd_cmd_len    (rd_cmd_len     ),
        .rd_cmd_ready  (rd_cmd_ready   ),
        .rd_cmd_done   (rd_cmd_done    ),
        .read_ready    (1'b1           ),
        .read_rdata    (rd_rdata       ),
        .read_en       (rd_rdata_en    ),
        .axi_awaddr    (axi_awaddr     ),
        .axi_awid      (axi_awid       ),
        .axi_awlen     (axi_awlen      ),
        .axi_awsize    (axi_awsize     ),
        .axi_awburst   (axi_awburst    ),
        .axi_awready   (axi_awready    ),
        .axi_awvalid   (axi_awvalid    ),
        .axi_wdata     (axi_wdata      ),
        .axi_wstrb     (axi_wstrb      ),
        .axi_wlast     (axi_wlast      ),
        .axi_wvalid    (axi_wvalid     ),
        .axi_wready    (axi_wready     ),
        .axi_bid       (axi_bid        ),
        .axi_bresp     (2'd0           ),
        .axi_bvalid    (1'b0           ),
        .axi_bready    (               ),
        .axi_araddr    (axi_araddr     ),
        .axi_arid      (axi_arid       ),
        .axi_arlen     (axi_arlen      ),
        .axi_arsize    (axi_arsize     ),
        .axi_arburst   (axi_arburst    ),
        .axi_arvalid   (axi_arvalid    ),
        .axi_arready   (axi_arready    ),
        .axi_rready    (axi_rready     ),
        .axi_rdata     (axi_rdata      ),
        .axi_rvalid    (axi_rvalid     ),
        .axi_rlast     (axi_rlast      ),
        .axi_rid       (axi_rid        ),
        .axi_rresp     (2'd0           )
    );

    //=========================================================================
    // 五、初始化完成（沿用原逻辑：显示流写过一整帧才算就绪）
    //=========================================================================
    reg init_done_r;
    always @(posedge ddr_clk) begin
        if (dis_wirq) init_done_r <= 1'b1;
        else          init_done_r <= init_done_r;
    end
    assign init_done = init_done_r;

endmodule

//=============================================================================
//=============================================================================
// module cam_frm_wr  --  摄像头整帧 1:1 写发生器（版本二 2026-10-30 第三版）
//
//   ★ 本次改动（2026-10-30 晚）：写侧从"148.5MHz + phase 拉伸"改回
//     "摄像头自己的时钟 + 1:1 写"。
//
//   旧实现（本文件上一版）的两个毛病，正是上板花屏/错位/斜纹的根因：
//     (1) 整个模块跑在 pixclk_in(148.5MHz) 域，靠行缓存的 line_new 跨域触发。
//         摄像头行事件跨到 148.5MHz 域采样，会漏采/多采一行；wr_buf 的行指针
//         与摄像头行号就会慢慢错开 -> 斜纹、逐帧滚动。
//     (2) 写侧用 ltog 做 phase 拉伸（每两行中的一行写两遍，720 -> 1080 的
//         1.5 倍纵向放大）。写指针与源行不再是 1:1，再叠加 (1) 的漂移
//         -> 行错位、花屏。
//
//   现在（回到 1944 黄金版已验证的结构）：
//       · 跑 cam_pclk_16bit —— 摄像头自己的像素时钟（来自 cmos_8_16bit）
//       · 1:1 写：de_in 有效 1 拍 = 写 1 个像素；摄像头 1 行 = 帧缓存 1 行
//       · 所有拉伸（水平 640->960、垂直 480->1080）全部移到【读侧】
//         cam_line_rd，用 Bresenham 按地址算
//
//   本模块剩下四件事：
//       1) 像素直通（可选测试图案）
//       2) 行内截断到 H_NUM 个像素
//          为什么必须截断：wr_buf 的 write_en 用 x_cnt[0] 把相邻两像素打包成
//          一个 32bit 字，读侧每次固定搬 RD_LINE_NUM 拍。每行像素数必须一样多，
//          多了少了都会让写指针相对读指针漂移 -> 整行累积错位。
//       3) 帧末发 o_fsync（只在 VSYNC 上升沿）
//       4) 行数诊断（帧末锁存，给"实测摄像头每帧到底多少行"用）
//
//   ⚠️ 铁律：o_fsync 绝不能在一帧中间发（framebuf 会中途复位 -> 花屏）。
//      VSYNC 上升沿天然在一帧结束之后（垂直消隐开始），所以只认它的上升沿。
//   ⚠️ 铁律：每行 o_en 必须连续高 >= H_NUM-20 拍、行间低 >= 1 拍。
//      这里 o_en 连续高恰好 H_NUM 拍（640），行间由摄像头 HREF 的低电平拉开。
//=============================================================================
module cam_frm_wr #(
    parameter integer H_NUM = 640,      // 每行写入像素数（= 摄像头真实行宽）
    parameter integer V_NUM = 480       // 每帧行数（仅注释/诊断，不参与地址）
)(
    input  wire        clk,          // cam_pclk_16bit（摄像头像素时钟）
    input  wire        rst_n,
    input  wire        vs_in,        // 摄像头 VSYNC（高有效）
    input  wire        pat_en,       // 1 = 输出测试图案（隔离帧缓存通路用）
    input  wire        de_in,        // 摄像头行有效：1 像素/拍
    input  wire [15:0] pix_in,       // RGB565
    output reg         o_fsync,      // 帧边界 1 拍脉冲
    output reg         o_en,         // 写使能（每行连续 H_NUM 拍）
    output reg  [15:0] o_px,
    output reg  [11:0] o_rows,       // 本帧已写行数（实时）
    output reg  [11:0] o_lines       // 上一帧实际行数（帧末锁存，诊断用）
);

    //--------------------------------------------------------------------
    // VSYNC 打三拍后取上升沿（本时钟域同步 + 边沿检测）
    //--------------------------------------------------------------------
    reg [2:0] vs_s;
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) vs_s <= 3'd0;
        else        vs_s <= {vs_s[1:0], vs_in};
    end
    wire vs_rise = (vs_s[2:1] == 2'b01);

    //--------------------------------------------------------------------
    // 行内像素计数 / 帧内行计数
    //--------------------------------------------------------------------
    reg [11:0] px_cnt;           // 本行已通过 de 的像素数
    reg [11:0] row_cnt;          // 本帧已开始的行数
    reg        de_d;

    // 测试图案：第 100..103 列竖线 + 每 128 行画 4 行横线，任何错位一眼可见
    wire [15:0] pat_px = (((px_cnt >= 12'd100) && (px_cnt < 12'd104))
                            ? 16'hFFFF
                            : ((row_cnt[6:0] < 7'd4) ? 16'hF800 : 16'h001F));

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            px_cnt  <= 12'd0;
            row_cnt <= 12'd0;
            de_d    <= 1'b0;
            o_en    <= 1'b0;
            o_px    <= 16'd0;
            o_fsync <= 1'b0;
            o_rows  <= 12'd0;
            o_lines <= 12'd0;
        end else begin
            o_fsync <= vs_rise;                    // 只认 VSYNC 上升沿
            de_d    <= de_in;

            // 1:1 直通；行内只放前 H_NUM 个像素
            o_en <= de_in && (px_cnt < H_NUM);
            o_px <= pat_en ? pat_px : pix_in;

            // 行内计数：de 一低就归零（wr_buf 内部的 x_cnt 也是靠 wr_en 低电平归零，
            // 两边同拍动作，packing 的奇偶才对得上）
            if (!de_in)              px_cnt <= 12'd0;
            else if (px_cnt < H_NUM) px_cnt <= px_cnt + 12'd1;

            // 行计数：每个 de 上升沿算一行
            if (de_in && !de_d) begin
                if (row_cnt != 12'd4095) row_cnt <= row_cnt + 12'd1;
                o_rows <= row_cnt + 12'd1;
            end

            // 帧末：锁存上一帧真实行数，计数器归零
            if (vs_rise) begin
                o_lines <= row_cnt;
                o_rows  <= 12'd0;
                row_cnt <= 12'd0;
            end
        end
    end

endmodule

//=============================================================================
// module cam_line_rd  --  摄像头帧读取 + 双轴 Bresenham 拉伸（版本二 2026-10-30）
//
//   用途：把摄像头帧缓存（SRC_W x SRC_H = 640x480）放大到右半屏
//         （DST_W x DST_H = 960x1080）。写侧完全 1:1，拉伸全在这里用地址算。
//
//   为什么不能用厂商 rd_buf：
//     它每行都把 DDR 里的"下一行"搬进来，行号只会 +1，没法让同一行显示两遍，
//     所以做不了纵向放大（480 -> 1080）。纵向放大必须能控制"本显示行取源第
//     几行"，只能自己维护行指针。
//
//   结构（和厂商 rd_buf 一样是"每显示行读一行"，单 bank 行缓存）：
//     · 行起点（rd_de 且 rd_x==0）用纵向 Bresenham 决定本行取源第几行
//     · 只有源行号真的前进时才发 DDR 读请求；重复行直接复用行缓存里的数据
//     · 读回的 256bit 拍按 BEATS 拍写进行缓存（rd_fram_buf，256bit 写 / 32bit 读）
//     · 右半屏（x=DST_X0..）逐像素输出：水平 Bresenham 决定取源第几列
//     · 行缓存按"源行号 mod 8"分槽：每槽 64 个 256bit 入口 = 512 个 32bit 字
//       = 512 个 32bit 字 = 1024 像素容量（640 只用前 320 字），8 槽正好 4096 字
//
//   时序预算（关键，别乱动）：
//     行起点发请求 -> 40 拍 DDR 读（约 100 拍）-> 左半屏 960 拍内肯定读完
//     -> rd_x=957 开始产生像素
//     -> 流水 3 级：行缓存 1 拍读延迟 + 半字选择打 2 拍 + 输出寄存器 1 拍
//        （⚠️ 半字选择必须和读延迟同级对齐，否则每个 32bit 字会取错半个像素：
//          仿真里表现为每组 3 像素变成 [a,b,a] 而不是 [a,a,b]，画面是细碎色边）
//     -> vout_de/vout_data 都晚 3 拍，正好落在 x=960..1919
//
//   像素位序（与厂商 rd_buf.v 的 PIX_WIDTH==16 分支完全一致）：
//     32bit 字 a 里，源像素 2a 在 [31:16]、源像素 2a+1 在 [15:0]。
//     ⚠️ 这个位序是从"已在板上验证过的显示通路"照抄来的，不能按写侧的
//        {wr_data, wr_data_1d} 去推——中间隔了 wr_fram_buf/rd_fram_buf
//        两次宽窄转换，推错的代价是一整次编译。
//=============================================================================
module cam_line_rd #(
    parameter integer SRC_W  = 640,     // 源行宽（= 写侧 cam_frm_wr 的 H_NUM）
    parameter integer SRC_H  = 480,     // 源行数（= 摄像头每帧真实行数）
    parameter integer DST_X0 = 960,     // 右半屏起点
    parameter integer DST_W  = 960,     // 右半屏宽
    parameter integer DST_H  = 1080     // 屏幕高
)(
    input  wire         vout_clk,
    input  wire         ddr_clk,
    input  wire         rst_n,
    input  wire         rd_fsync,      // 帧头（vout_clk 域）
    input  wire         rd_de,         // 显示 DE（与 rd_x 对齐，vout_clk 域）
    input  wire [11:0]  rd_x,          // 显示 x 坐标（vout_clk 域）
    input  wire         frame_bank,    // 读哪一块 DDR3 帧缓存（ddr_clk 域稳定电平）
    input  wire [27:0]  base_addr,     // 摄像头帧缓存基地址（DDR3 32bit 字地址）
    output reg          ddr_rreq,      // 1 拍读请求
    output wire [27:0]  ddr_raddr,
    output wire [31:0]  ddr_rd_len,
    input  wire         ddr_rdone,     // 本次行读事务结束
    input  wire         ddr_rdata_en,  // 每个 256bit 拍
    input  wire [255:0] ddr_rdata,
    output wire [15:0]  vout_data,
    output wire         vout_de
);

    localparam integer BEATS  = SRC_W*16/256;       // 每行 256bit 拍数（640 -> 40）
    localparam integer STRIDE = SRC_W/2;            // 每行 32bit 字数（必须等于 wr_buf 的 DDR_ADDR_OFFSET）
    localparam [11:0]  SW     = SRC_W;              // 源行宽（12bit 化，便于比较）
    localparam [11:0]  GEN0   = DST_X0 - 3;         // 957：提前 3 拍（读延迟 1 + 两级寄存）
    localparam [11:0]  GEN1   = DST_X0 + DST_W - 1; // 1919：多跑 3 拍把流水排空
                                                    //（多出的 3 个像素不输出，见 vout_de）
    localparam [11:0]  X0     = DST_X0;             // 右半屏第一列
    localparam [11:0]  X1     = DST_X0 + DST_W - 1; // 右半屏最后一列
    localparam [31:0]  RD_LEN = BEATS;

    //=====================================================================
    // 一、vout_clk 域：帧/行状态、纵向 Bresenham、水平 Bresenham、像素输出
    //=====================================================================
    reg  [11:0] buf_sy;        // 行缓存里现在是源第几行（12'hFFF = 还没有）
    reg  [11:0] sy;            // 本显示行取源第几行
    reg  [12:0] acc_v;         // 纵向 Bresenham 累加器
    reg         first;         // 帧内第一行（不推进累加器）
    reg         req_tgl;       // 读请求翻转（跨到 ddr_clk 域）
    reg  [11:0] req_row;       // 请求的源行号

    reg  [11:0] sx;            // 水平：当前取源第几列
    reg  [12:0] acc_h;         // 水平 Bresenham 累加器
    reg  [11:0] rd_word;       // 行缓存读地址（32bit 字）
    reg  [11:0] sx_d1, sx_d2;  // 源列号打两拍（必须和"读延迟 1 拍 + 输出寄存 1 拍"对齐）
    reg  [15:0] pix_r;         // 输出像素

    wire line_start = rd_de && (rd_x == 12'd0);
    wire gen        = rd_de && (rd_x >= GEN0) && (rd_x <= GEN1);

    // 纵向：acc_v + SRC_H 跨过 DST_H 就换下一源行，否则本行重复上一源行
    //   （480 -> 1080 = 每 9 个显示行只前进 4 个源行）
    wire [12:0] acc_v_n  = acc_v + SRC_H;
    wire        adv_v    = (acc_v_n >= DST_H);
    wire [12:0] acc_v_nx = adv_v ? (acc_v_n - DST_H) : acc_v_n;
    wire [11:0] tgt_sy   = (first || !adv_v) ? sy : (sy + 12'd1);
    wire [12:0] tgt_acc  = first ? 13'd0 : acc_v_nx;

    // 水平：acc_h + SRC_W 跨过 DST_W 就在下一像素用源下一列
    //   （640 -> 960 = 每 3 个显示像素取 2 个源像素，第 1 个重复一次）
    wire [12:0] acc_h_n  = acc_h + SRC_W;
    wire        adv_h    = (acc_h_n >= DST_W);
    wire [11:0] slot_word = {buf_sy[2:0], 9'd0};            // 行槽基址（32bit 字）
    wire [11:0] word_addr = slot_word + {2'b0, sx[10:1]};   // 槽基址 + 列字偏移

    wire [31:0] lb_word;                                    // 行缓存读数据

    always @(posedge vout_clk or negedge rst_n) begin
        if (!rst_n) begin
            buf_sy  <= 12'hFFF;
            sy      <= 12'd0;
            acc_v   <= 13'd0;
            first   <= 1'b1;
            req_tgl <= 1'b0;
            req_row <= 12'd0;
            sx      <= 12'd0;
            acc_h   <= 13'd0;
            rd_word <= 12'd0;
            sx_d1   <= 12'd0;
            sx_d2   <= 12'd0;
            pix_r   <= 16'd0;
        end else begin
            //---------------- 像素流水（★ 每一拍都要移，不能只在 gen 里移） ----------------
            //   gen 比输出窗口早 3 拍（行缓存数据要到"最后一拍 gen + 2"才全部出来）。
            //   如果只在 gen 里更新 pix_r，gen 一低 pix_r 就冻住，每行最后 1 个像素
            //   会重复上一个像素（仿真实测：本该 639 却出 638）。
            pix_r <= sx_d2[0] ? lb_word[15:0] : lb_word[31:16];

            //---------------- 帧头：纵向状态归零，强行重取第 0 行 ----------------
            if (rd_fsync) begin
                buf_sy <= 12'hFFF;
                sy     <= 12'd0;
                acc_v  <= 13'd0;
                first  <= 1'b1;
            end

            //---------------- 行起点：定本行源行号 + 水平状态归零 + 需要时发读请求 ----------------
            //   ⚠️ 水平状态必须在这里清零，不能写成 "!gen 就清零"：
            //      那样 gen 一落，sx_d2 会在最后几个像素的流水里被改成 0，
            //      最后一个像素的半字选择就会取错（仿真里正好差 1 个像素）。
            if (line_start) begin
                sy    <= tgt_sy;
                acc_v <= tgt_acc;
                first <= 1'b0;
                sx    <= 12'd0;
                acc_h <= 13'd0;
                if (tgt_sy != buf_sy) begin
                    req_row <= tgt_sy;
                    req_tgl <= ~req_tgl;
                    buf_sy  <= tgt_sy;
                end
            end

            //---------------- 右半屏：地址/计数推进（rd_x=957 起，比窗口早 3 拍） ----------------
            if (gen) begin
                rd_word <= word_addr;
                sx_d1   <= sx;
                sx_d2   <= sx_d1;
                // 最后一列钳住：gen 比窗口多跑 3 拍（为了把流水排空），
                // 不钳的话会把 sx 推到 SRC_W（越界），最后几个像素会取错半字。
                if (sx < SW - 12'd1) begin
                    if (adv_h) begin
                        sx    <= sx + 12'd1;
                        acc_h <= acc_h_n - DST_W;
                    end else begin
                        acc_h <= acc_h_n;
                    end
                end
            end
        end
    end

    //=====================================================================
    // 二、ddr_clk 域：请求跨域 + 发读事务 + 行缓存填充
    //=====================================================================
    reg         req_s, req_s1;
    reg         pend;              // 有一笔请求还没真正发出
    reg  [11:0] pend_row;
    reg         busy;              // 本次行读事务进行中
    reg  [11:0] row_d;             // 正在读的源行号
    reg  [8:0]  fill_addr;         // 行缓存写地址（256bit 入口）

    wire req_pulse = (req_s ^ req_s1);

    always @(posedge ddr_clk or negedge rst_n) begin
        if (!rst_n) begin
            req_s  <= 1'b0;
            req_s1 <= 1'b0;
        end else begin
            req_s  <= req_tgl;
            req_s1 <= req_s;
        end
    end

    always @(posedge ddr_clk or negedge rst_n) begin
        if (!rst_n) begin
            ddr_rreq  <= 1'b0;
            pend      <= 1'b0;
            pend_row  <= 12'd0;
            busy      <= 1'b0;
            row_d     <= 12'd0;
            fill_addr <= 9'd0;
        end else begin
            ddr_rreq <= 1'b0;      // 1 拍请求，和厂商 rd_buf 一样靠仲裁器的 rpend 挂起

            if (pend && !busy) begin
                busy      <= 1'b1;
                ddr_rreq  <= 1'b1;
                row_d     <= pend_row;
                fill_addr <= {pend_row[2:0], 6'd0};    // 本行的 256bit 槽基址
                pend      <= 1'b0;
            end else if (ddr_rdone) begin
                busy <= 1'b0;
            end

            // 新请求（放在后面：同一拍既有待发又有新请求时，新请求不会被吃掉）
            if (req_pulse) begin
                pend     <= 1'b1;
                pend_row <= req_row;
            end

            if (ddr_rdata_en) fill_addr <= fill_addr + 9'd1;
        end
    end

    // DDR3 行地址 = 基址 + 帧 bank 偏移 + 源行号*每行字数
    //   bank 偏移 = 2^21 字（wr_buf 里帧位在 LINE_ADDR_WIDTH=21 位上）
    wire [27:0] row_off  = row_d * STRIDE;
    wire [27:0] bank_off = {1'b0, frame_bank, 21'd0};
    assign ddr_raddr  = base_addr + bank_off + row_off;
    assign ddr_rd_len = RD_LEN;

    //=====================================================================
    // 三、行缓存（256bit 写 / 32bit 读，双时钟）
    //=====================================================================
    rd_fram_buf u_row_buf (
        .wr_data  (ddr_rdata    ),
        .wr_addr  (fill_addr    ),
        .wr_en    (ddr_rdata_en ),
        .wr_clk   (ddr_clk      ),
        .wr_rst   (~rst_n       ),
        .rd_addr  (rd_word      ),
        .rd_data  (lb_word      ),
        .rd_clk   (vout_clk     ),
        .rd_rst   (~rst_n       )
    );

    assign vout_data = pix_r;
    // de 直接由【当前】rd_x/rd_de 判定：流水已把 pix_r 对齐到"时钟 = 显示 x"，
    // 所以这里不需要再延时链（用延时链会在行尾多出 3 拍，落进消隐区还得再门控）。
    assign vout_de   = rd_de && (rd_x >= X0) && (rd_x <= X1);

endmodule
