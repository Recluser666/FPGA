# pixclk_in = 148.5 MHz (1080p60 pixel clock).
#   This is the clock that drives the HDMI write path; without this
#   constraint PDS treats it as a 1 MHz placeholder and never optimizes
#   the 6.7 ns paths -> data corruption / tearing.
#   Same 6.734 ns value is used by the 2023 first-prize project.
create_clock -name {pixclk_in} [get_ports {pixclk_in}] -period {6.734} -waveform {0.000 3.367}
set_clock_groups -name pixclk_in_grp -asynchronous -group [get_clocks {pixclk_in}]

###==== 2026-10-27: HDMI-IN reset (R17) ====
# The board HDMI-IN port has a DDC/EDID path gated by R17.
# sys_top / ddr3_fb previously did not drive this pin (floating), so the laptop
# could not read EDID -> Windows thought no display -> no output -> we saw noise.
define_attribute {p:hdmi_rst} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:hdmi_rst} {PAP_IO_LOC} {R17}
define_attribute {p:hdmi_rst} {PAP_IO_VCCIO} {3.3}
define_attribute {p:hdmi_rst} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:hdmi_rst} {PAP_IO_DRIVE} {8}
define_attribute {p:hdmi_rst} {PAP_IO_NONE} {TRUE}
define_attribute {p:hdmi_rst} {PAP_IO_SLEW} {FAST}
###==== END hdmi_rst ====
