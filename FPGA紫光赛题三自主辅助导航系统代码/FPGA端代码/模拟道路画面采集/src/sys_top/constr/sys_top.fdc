#############################################################################
# IP internal placement attributes (copied from the vendor top .fdc)
#   Without these the placer picks a bad location for the DDR3 PLL and aborts
#   pnr with: Place-0084 IO_CLOCK ... fixed at PLL_158_179 is unreasonable.
#############################################################################
###==== BEGIN Attributes
define_attribute {i:u_DDR3_50H.u_ipsxb_ddrphy_pll_0.u_pll_e3} {PAP_LOC} {PLL_158_199}
define_attribute {i:u_DDR3_50H.u_ipsxb_ddrphy_pll_1.u_pll_e3} {PAP_LOC} {PLL_158_179}
define_attribute {i:u_DDR3_50H.u_ddrphy_top.ddrphy_reset_ctrl.ddrphy_ioclk_gate} {PAP_LOC} {CLMA_150_192:FF3}
###==== END Attributes

#############################################################################
# PCIe part - merged from D:/fpga/pcie_comm/constr/pcie_comm.fdc,
# hierarchy re-rooted to u_pcie (this top instantiates pango_pcie_top as a
# sub-block). GT pins (rxp/rxn/txp/txn/ref_clk_p/n) are auto-placed by PDS,
# they are NOT constrained here on purpose. Board LEDs are owned by this top
# (led[3:0]), so pcie_comm own LED LOCs are intentionally dropped.
#############################################################################

###==== BEGIN PCIe clocks
# ===== 2026-10-25: PCIe pclk constraint temporarily relaxed 250MHz -> 200MHz =====
#   Why: the M.2 -> PCIe adapter has not arrived yet. This 250MHz domain is
#        currently UNUSED, but it missed by 0.112ns, which made the whole
#        design report "Some Constraints Violated", so PDS stopped optimizing
#        the other paths and the display chain became unstable (black/flicker).
#   WARNING: restore period 4.000 (250MHz) before running real PCIe traffic.
create_clock -name {pclk} [get_pins {g_pcie_on.u_pcie/u_pcie/u_pcie_top/u_pcie_soft_phy/pclk}] -period {4.000} -waveform {0.000 2.000}
create_clock -name {pclk_div2} [get_pins {g_pcie_on.u_pcie/u_pcie/u_pcie_top/u_pcie_soft_phy/pclk_div2}] -period {8.000} -waveform {0.000 4.000}
###==== END PCIe clocks

###==== BEGIN PCIe clock groups
set_clock_groups -name pclk_grp -asynchronous -group [get_clocks {pclk}]
set_clock_groups -name pclk_div2_grp -asynchronous -group [get_clocks {pclk_div2}]
###==== END PCIe clock groups

###==== BEGIN PCIe clock buffer assignment
# pclk / pclk_div2 are generated inside the IP soft_phy and already buffered.
# (the old define_attribute paths belonged to the pre-generate top; invalid now)
# ref_clk: no clock loads are reported for it (it only feeds the GT macro), constraint dropped
###==== END PCIe clock buffer assignment

###==== BEGIN PCIe board pins
define_attribute {p:perst_n} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:perst_n} {PAP_IO_LOC} {A19}
define_attribute {p:perst_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:perst_n} {PAP_IO_STANDARD} {LVCMOS33}
