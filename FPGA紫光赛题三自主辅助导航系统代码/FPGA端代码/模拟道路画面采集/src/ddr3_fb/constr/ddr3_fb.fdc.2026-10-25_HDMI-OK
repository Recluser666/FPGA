# ============================================================================
# Clock constraints (2026-10-25 added)
#
#   WHY: this .fdc had NO create_clock at all, so PDS treated every clock as a
#   1 MHz placeholder and never optimized any path. "All Constraints Met" was
#   therefore meaningless, and the 148.5 MHz HDMI write path (hdmi_wr ->
#   fram_buf.wr_*) was completely unconstrained -> data corruption -> tearing.
#
#   Frequencies:
#     sys_clk   : 50.000 MHz  (20.000 ns)  board oscillator, pin P20
#     pixclk_in : 148.500 MHz (6.734 ns)   HDMI input pixel clock, pin AA12
#                                           (1080p60; same value the 2023
#                                            first-prize project used)
#
#   Only leaf INPUT ports are constrained here. PLL output clocks are derived
#   automatically by PDS from the PLL IP; adding create_generated_clock lines
#   whose objects do not match ABORTS the flow (see note near line 696 above).
# ============================================================================
create_clock -name {sys_clk}   -period {20.000} -waveform {0.000 10.000} [get_ports {sys_clk}]
create_clock -name {pixclk_in} -period {6.734}  -waveform {0.000 3.367}  [get_ports {pixclk_in}]

# The HDMI pixel clock and the board clock are asynchronous to each other.
set_clock_groups -name {async_sys_pix} -asynchronous \
    -group [get_clocks {sys_clk}] \
    -group [get_clocks {pixclk_in}]
